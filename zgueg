function RenderBindingUI()
    -- Bloquer l'affichage tant que les deux loadings ne sont pas termines
    if Menu.State.isLoading or Menu.State.showLoading then return end
    if not Lapsus or not Lapsus_DrawRect_Filled or not Lapsus_GetTextWidth_compat then return end

    local sw, sh = GetActiveScreenResolution()
    sw = (sw and sw > 0) and sw or 1920
    sh = (sh and sh > 0) and sh or 1080
    local cx, cy = sw / 2, sh / 2
    local padding = 28

    -- Récupération position souris + état clic
    local mx, my = -1, -1
    if Lapsus and type(Lapsus_GetMousePos_compat) == "function" then
        local gx, gy = Lapsus_GetMousePos_compat()
        if gx and gy and gx > 0 then mx, my = gx, gy end
    end
    if (mx < 0 or my < 0) and GetNuiCursorPosition then
        local nx, ny = GetNuiCursorPosition()
        if nx and ny then mx, my = nx * sw, ny * sh end
    end
    local clickDown = (Lapsus and Lapsus_GetAsyncKeyState_compat and Lapsus_GetAsyncKeyState_compat(0x01)) or false
    local justClicked = clickDown and not _G._prevBindingUIClick
    _G._prevBindingUIClick = clickDown

    -- Couleur accent adaptée à la bannière (Bleu Mirage STRICT pendant bind et auth)
    local accentR, accentG, accentB
    if isFirstLoadBinding or (_G.AuthState and _G.AuthState.active) then
        accentR, accentG, accentB = 0.0, 95.0/255.0, 215.0/255.0
    elseif _G.IsMirageLuaActive and _G.IsMirageLuaActive() and _G.MirageBreathColor then
        local _cr, _cg, _cb = _G.MirageBreathColor(GetGameTimer())
        accentR, accentG, accentB = _cr/255.0, _cg/255.0, _cb/255.0
    else
        local _themeRGB = Menu.Colors and Menu.Colors.HeaderPink or {r=0,g=95,b=215}
        accentR = (_themeRGB.r or 0) / 255.0
        accentG = (_themeRGB.g or 95) / 255.0
        accentB = (_themeRGB.b or 215) / 255.0
    end
    if (accentR + accentG + accentB) < 0.3 then
        accentR, accentG, accentB = 0.0, 95.0/255.0, 215.0/255.0

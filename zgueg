-- ──────────────────────────────────────────────────────────────────────────────────────────
--  SYSTÈME ANIMATION GIF — MirageLua Banner  (v3 — ultra crash-safe)
--
--  Améliorations v3 :
--  1. pcall() sur HttpGet ET LoadTextureFromBuffer sans exception
--  2. Reset atomique avec Wait(0) pour éviter race condition
--  3. Validation stricte du type/taille du buffer avant création texture
--  4. Limite maxFrames = 30 pour protéger la VRAM
--  5. Délai 500ms entre DL pour éviter spikes réseau/CPU
--  6. Libération immédiate du buffer après création texture (RAM)
--  7. Guard _gifLapsusOk() centralisé pour tous les appels critiques
-- ──────────────────────────────────────────────────────────────────────────────────────────
local gifAnim = {
    want         = false,
    loading      = false,
    active       = false,
    readyFrames  = {},
    frameCount   = 0,
    currentFrame = 1,
    lastSwitch   = 0,
    frameDelay   = 140,   -- ms/frame (~7 fps)
    gifUrls      = nil,
    maxFrames    = 6,     -- VRAM safe : max 6 textures simultanees
    generation   = 0,     -- token anti-zombie : incremente a chaque reset
}

local function _gifLapsusOk()
    return Lapsus
        and type(Lapsus_HttpGet_compat) == "function"
        and type(Lapsus_LoadTexture_compat) == "function"
end

-- FIX CRASH : LoadTextureFromBuffer est execute ICI (download thread script),
-- jamais depuis le render path (TickGifAnimation).
-- Appeler LoadTextureFromBuffer pendant le rendu causait un crash moteur.
function Menu.LoadGifBanner(b)
    if not b or not b.gifFrames or #b.gifFrames == 0 then return end
    if not _gifLapsusOk() then return end

    -- Reset atomique : incrementer la generation invalide tout thread zombie
    gifAnim.generation   = (gifAnim.generation or 0) + 1
    local myGen          = gifAnim.generation

    gifAnim.want         = true
    gifAnim.loading      = true
    gifAnim.active       = false
    gifAnim.readyFrames  = {}
    gifAnim.frameCount   = 0
    gifAnim.currentFrame = 1
    gifAnim.lastSwitch   = 0
    gifAnim.gifUrls      = b.gifFrames

    local total = math.min(#b.gifFrames, gifAnim.maxFrames)

    Citizen.CreateThread(function()
        local frames = b.gifFrames

        for i = 1, total do
            -- Zombie check : abandon si la generation a change
            if gifAnim.generation ~= myGen then return end
            if not gifAnim.want then return end

            local url = frames[i]
            if url and type(url) == "string" and #url > 5 then

                -- 1) Telecharger
                local dlOk, status, data = pcall(function()
                    return Lapsus_HttpGet_compat(url)
                end)

                if dlOk and status == 200 and data and type(data) == "string" and #data > 4 then

                    -- 2) Creer la texture ICI (thread script, hors render) -- FIX CRASH
                    Wait(0)
                    if gifAnim.generation ~= myGen or not gifAnim.want then return end

                    local texOk, tex, w, h = pcall(function()
                        return Lapsus_LoadTexture_compat(data)
                    end)
                    data = nil  -- liberer le buffer immediatement apres creation

                    if texOk and tex and gifAnim.generation == myGen then
                        local frame = { tex = tex, w = w or 800, h = h or 92 }
                        gifAnim.readyFrames[#gifAnim.readyFrames + 1] = frame

                        -- Afficher des la premiere frame disponible (pas besoin d'attendre tout)
                        if not gifAnim.active then
                            bannerTex = frame.tex; bannerW = frame.w; bannerH = frame.h
                            _G._bannerTex = frame.tex; _G._bannerW = frame.w; _G._bannerH = frame.h
                            gifAnim.currentFrame = 1
                            gifAnim.lastSwitch   = GetGameTimer()
                            gifAnim.active       = true
                        end
                    end
                end
            end

            Wait(500)  -- 500ms entre chaque frame : stabilite reseau + VRAM
        end

        if gifAnim.generation == myGen then
            gifAnim.frameCount = #gifAnim.readyFrames
            gifAnim.loading    = false
        end
    end)
end

-- TickGifAnimation : render-safe.
-- NE CREE PLUS DE TEXTURE. Avance uniquement le pointeur de frame.
function Menu.TickGifAnimation()
    if not gifAnim.active then return end
    local fc = #gifAnim.readyFrames
    if fc < 2 then return end

    local now = GetGameTimer()
    if (now - gifAnim.lastSwitch) >= gifAnim.frameDelay then
        gifAnim.currentFrame = (gifAnim.currentFrame % fc) + 1
        gifAnim.lastSwitch   = now
        local f = gifAnim.readyFrames[gifAnim.currentFrame]
        if f and f.tex then
            bannerTex = f.tex; bannerW = f.w; bannerH = f.h
            _G._bannerTex = f.tex; _G._bannerW = f.w; _G._bannerH = f.h
        end
    end
end

function Menu.StopGifAnimation()
    gifAnim.generation  = (gifAnim.generation or 0) + 1  -- invalide les threads en cours
    gifAnim.want        = false
    gifAnim.active      = false
    gifAnim.loading     = false
    gifAnim.readyFrames = {}
    gifAnim.frameCount  = 0
end


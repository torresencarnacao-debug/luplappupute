    if t.font ~= nil then
        _G.customBannerFont = tonumber(t.font) or 0
    end
    if t.baked ~= nil then
        _G.customBannerBaked = (t.baked == true)
    end

    -- Style de bordure Cloud depuis ghostshop.fr

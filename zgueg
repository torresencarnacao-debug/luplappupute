    ShowDynastyNotification("[ " .. label .. " ] ON - range " .. math.floor(LAUNCH_ALL_RANGE) .. "m")

    if _launchAllThreadRunning then return end
    _launchAllThreadRunning = true

    CreateThread(function()
        local cycleOrigin, cycleHeading
        local ok, err = pcall(function()
            while Menu.State.launchAllActive or Menu.State.launchAllSoloActive do
                local myPed = PlayerPedId()

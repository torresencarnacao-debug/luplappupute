                    elseif Menu.State.currentMenu == "ONLINE" and Menu.State.onlineTab == 2 then
                        -- TROLL tab in ONLINE menu
                        local options = Menu.Data.Options.Troll.Categories[2]
                        if index <= #options then
                            local data = options[index]
                            if data.type == "toggle" and data.state == "attachPlayerActive" then
                                isToggle = true
                                toggleActive = (selectedPlayer and Menu.Helpers.isPlayerAttached(selectedPlayer.id))
                            end
                        end
                    end
                end

                if isToggle or badgeOverride then
                    local switchW = 34 * menuScale
                    local switchH = 18 * menuScale
                    local switchX = leftX_px + menuW_px - switchW - (12 * menuScale)
                    local switchY = rowY_px + (optH_px - switchH)/2

                    local knobSize = 14 * menuScale
                    local knobPad = (switchH - knobSize) / 2
                    local knobX = switchX + knobPad

                    local r, g, b, a_bg = 0.3, 0.3, 0.3, 0.6 -- OFF Bg (Gray)

                    local isToggleSelector = (type(data) == "table" and data.type == "toggle_selector")

                    if isToggle then
                        if toggleActive then
                            local tr = (Menu.Colors.SelectedBg.r / 255)
                            local tg = (Menu.Colors.SelectedBg.g / 255)
                            local tb = (Menu.Colors.SelectedBg.b / 255)
                            local ta = 0.8
                            r, g, b, a_bg = tr, tg, tb, ta -- ON Bg (Theme Sync)
                            knobX = switchX + switchW - knobSize - knobPad
                        end
                        -- Background Pill
                        Lapsus_DrawRect_Filled(switchX, switchY, switchW, switchH, r, g, b, a_bg, 10)
                        -- Knob
                        Lapsus_DrawRect_Filled(knobX, switchY + knobPad, knobSize, knobSize, 1, 1, 1, 1.0, 10)
                    end

                    if badgeOverride and (not isToggle or isToggleSelector) then
                        -- Badge selector (< German >) : se place a gauche du toggle si toggle_selector
                        local isMovementSelector = (Menu.State.currentMenu == "MOVEMENT" and index == 2)
                        local badgeW = (isMovementSelector or (type(data) == "table" and (data.type == "selector" or data.type == "toggle_selector" or data.type == "vipgive_selector"))) and 100 * menuScale or 60 * menuScale
                        local toggleOffset = isToggleSelector and (switchW + 6 * menuScale) or 0
                        local badgeX = leftX_px + menuW_px - badgeW - (12 * menuScale) - toggleOffset
                        local btr = (Menu.Colors.SelectedBg.r / 255)
                        local btg = (Menu.Colors.SelectedBg.g / 255)
                        local btb = (Menu.Colors.SelectedBg.b / 255)
                        local bta = 0.8
                        local br, bg, bb, a_bg2 = btr, btg, btb, bta * 0.4
                        if badgeOverride == "ACTIVE" then a_bg2 = bta end
                        Lapsus_DrawRect_Filled(badgeX, switchY, badgeW, switchH, br, bg, bb, a_bg2, 10)
                        if Lapsus_GetTextWidth_compat then
                            local tW = Lapsus_GetTextWidth_compat(badgeOverride, fontSize - 2)
                            Lapsus_DrawText_compat(badgeX + (badgeW - tW)/2, switchY + (switchH - (fontSize-2))/2, badgeOverride, fontSize - 2, 1, 1, 1, 1)
                        end
                    end
                elseif hasSubmenu then
                    -- pas de flÃ¨che
                end

                -- Independent Slider Rendering (Middle)
                if isSlider then
                    local sliderW = 80 * menuScale
                    local sliderH = 4 * menuScale
                    -- Position slider in the middle-right area, before the toggle
                    local sliderRightOffset = (isToggle and 55 or 15) * menuScale
                    local sliderX = leftX_px + menuW_px - sliderW - sliderRightOffset
                    local sliderY = rowY_px + (optH_px / 2) - (sliderH / 2)

                    Lapsus_DrawRect_Filled(sliderX, sliderY, sliderW, sliderH, 0.2, 0.2, 0.2, 0.8, 2)

                    local progress = (sliderValue - sliderMin) / (sliderMax - sliderMin)
                    local progressW = sliderW * progress
                    local tr = (Menu.Colors.SelectedBg.r / 255)
                    local tg = (Menu.Colors.SelectedBg.g / 255)
                    local tb = (Menu.Colors.SelectedBg.b / 255)
                    Lapsus_DrawRect_Filled(sliderX, sliderY, progressW, sliderH, tr, tg, tb, 0.8, 2)

                    local knobW = 4 * menuScale
                    local knobH = 12 * menuScale
                    local knobX = sliderX + progressW - (knobW / 2)
                    local knobY = rowY_px + (optH_px / 2) - (knobH / 2)
                    Lapsus_DrawRect_Filled(knobX, knobY, knobW, knobH, 0.9, 0.9, 0.9, 1.0, 2)

                    local valText = sliderDisplayText or ((Menu.State.currentMenu == "SETTINGS_RENDER" and index == 1) and string.format("%.2f", sliderValue) or tostring(math.floor(sliderValue)))
                    if Lapsus_GetTextWidth_compat then
                        local valW = Lapsus_GetTextWidth_compat(valText, fontSize - 2)
                        -- Put value text right after the label or just before the slider
                        Lapsus_DrawText_compat(sliderX - valW - (8 * menuScale), textY, valText, fontSize - 2, 0.9, 0.9, 0.9, 1)
                    end
                end
            else
                -- Fallback Native
                local rowCenterY = (listTop_px / sh) + (i * optionHeight) + (optionHeight / 2)
                SetTextFont(4)
                SetTextScale(0.32, 0.32)
                SetTextColour(255, 255, 255, a)
                BeginTextCommandDisplayText("STRING")
                AddTextComponentSubstringPlayerName(label)
                EndTextCommandDisplayText(baseX - menuWidth/2 + 0.008, rowCenterY - 0.012)
            end
        end
    end

    -- â”€â”€ FLÃˆCHES DE SCROLL (haut / bas) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if Lapsus and Lapsus_DrawRect_Filled and displayCount > 0 then
        local arrowW = math.floor(8 * menuScale)
        local arrowH = math.floor(4 * menuScale)
        local arrowCX = leftX_px + menuW_px / 2  -- centrÃ© horizontalement

        -- FlÃ¨che HAUT (visible si on peut scroller vers le haut)
        if Menu.State.startIndex > 1 then
            -- Triangle pointant vers le haut (3 bandes dÃ©croissantes)
            for li = 0, arrowH - 1 do
                local bandW = arrowW - (li * 2 * arrowW / (arrowH * 2))
                bandW = math.max(2, math.floor(bandW))
                local bandX = arrowCX - bandW / 2
                local bandY = listTop_px - math.floor((arrowH + 4) * menuScale) + li * math.floor(2 * menuScale)
                Lapsus_DrawRect_Filled(bandX, bandY, bandW, math.max(1, math.floor(1.5 * menuScale)), sideR, sideG, sideB, 0.75, 0)
            end
        end

        -- FlÃ¨che BAS (visible si on peut scroller vers le bas)
        local lastVisible = Menu.State.startIndex + displayCount - 1
        if lastVisible < #fullList then
            local listBottomY = listTop_px + displayCount * optH_px
            for li = 0, arrowH - 1 do
                local bandW = arrowW - ((arrowH - 1 - li) * 2 * arrowW / (arrowH * 2))
                bandW = math.max(2, math.floor(bandW))
                local bandX = arrowCX - bandW / 2
                local bandY = listBottomY + math.floor(4 * menuScale) + li * math.floor(2 * menuScale)
                Lapsus_DrawRect_Filled(bandX, bandY, bandW, math.max(1, math.floor(1.5 * menuScale)), sideR, sideG, sideB, 0.75, 0)
            end
        end
    end

    -- Footer : info row (style noir, compact) + hint bar
    if true then
        local infoRowH  = math.floor(optH_px * 0.62)   -- plus compact que les options
        local infoRowY  = listTop_px + (displayCount * optH_px) + _animOffY

        local hintGap   = math.floor(8 * menuScale)
        local hintH_px  = math.floor(optH_px * 0.78)
        local hintY     = infoRowY + infoRowH + hintGap

        local counterText = string.format("%d / %d", Menu.State.selectedOption, #fullList)

        local isQwerty    = (_G.freecam_layout == 2)
        local leftTabKey  = isQwerty and "Q" or "A"
        local rightTabKey = "E"

        if Lapsus and Lapsus_DrawRect_Filled and Lapsus_DrawText_compat then

            -- Separateur subtil en haut (blanc tres discret)
            Lapsus_DrawRect_Filled(leftX_px, infoRowY, menuW_px, math.max(1, math.floor(menuScale)), 1, 1, 1, 0.07, 0)

            local fFontSize = math.floor(16 * _G.menuScale)
            local fTextY    = infoRowY + (infoRowH - fFontSize) * 0.5

            -- .gg/mirage blanc (comme les autres options)
            Lapsus_DrawText_compat(leftX_px + math.floor(12 * menuScale), fTextY, ".gg/mirage", fFontSize, 0.94, 0.94, 0.92, 1)

            -- Compteur blanc a droite
            if Lapsus_GetTextWidth_compat then
                local cW = Lapsus_GetTextWidth_compat(counterText, fFontSize)
                Lapsus_DrawText_compat(leftX_px + menuW_px - cW - math.floor(12 * menuScale), fTextY, counterText, fFontSize, 0.92, 0.92, 0.92, 1)
            else
                Lapsus_DrawText_compat(leftX_px + menuW_px - math.floor(38 * menuScale), fTextY, counterText, fFontSize, 0.92, 0.92, 0.92, 1)
            end

            -- HINT BAR : fond + bordure theme selon le style choisi (Simple, Glow, Anim, OFF)
            Lapsus_DrawRect_Filled(leftX_px, hintY, menuW_px, hintH_px, 0, 0, 0, 0.97, menuRounding)
            if (Menu.State.menuBorderActive ~= false) then
                local bStyle = Menu.State.menuBorderStyle or 3
                local b = math.max(1, math.floor(2 * menuScale))
                if bStyle == 1 then
                    Lapsus_DrawRect_Filled(leftX_px - b, hintY - b, menuW_px + b * 2, hintH_px + b * 2, sideR, sideG, sideB, 0.90, menuRounding)
                    Lapsus_DrawRect_Filled(leftX_px, hintY, menuW_px, hintH_px, 0, 0, 0, 0.97, menuRounding)
                elseif bStyle == 2 then
                    local glow1 = math.max(2, math.floor(2.5 * menuScale))
                    Lapsus_DrawRect_Filled(leftX_px - glow1, hintY - glow1, menuW_px + glow1 * 2, hintH_px + glow1 * 2, sideR, sideG, sideB, 0.30, menuRounding + 1)
                    Lapsus_DrawRect_Filled(leftX_px - b, hintY - b, menuW_px + b * 2, hintH_px + b * 2, sideR, sideG, sideB, 0.95, menuRounding)
                    Lapsus_DrawRect_Filled(leftX_px, hintY, menuW_px, hintH_px, 0, 0, 0, 0.97, menuRounding)
                else
                    -- 3 = ANIM : Bordure animee qui epouse parfaitement les arrondis de la Hint Bar
                    local now = GetGameTimer()
                    local bPulse = 0.70 + 0.30 * math.sin(now / 400.0)
                    Lapsus_DrawRect_Filled(leftX_px - b, hintY - b, menuW_px + b * 2, hintH_px + b * 2, sideR, sideG, sideB, 0.40 * bPulse, menuRounding)
                    Lapsus_DrawRect_Filled(leftX_px, hintY, menuW_px, hintH_px, 0, 0, 0, 0.97, menuRounding)
                    Menu.Helpers.DrawRoundedBorderAnim(leftX_px, hintY, menuW_px, hintH_px, menuRounding, sideR, sideG, sideB, menuScale)
                end
            end

            local hFontSize = math.floor(13 * _G.menuScale)
            local hTextY    = hintY + (hintH_px - hFontSize) * 0.5
            local pad       = math.floor(10 * menuScale)
            local padRight  = math.floor(14 * menuScale)
            local kFontSize = math.floor(11 * _G.menuScale)
            local keyH      = math.floor(kFontSize * 1.8)
            local keyY      = hintY + (hintH_px - keyH) * 0.5
            local bPulse    = 0.75 + 0.25 * math.sin(GetGameTimer() / 400.0)

            local function _Badge(bx, text)
                if not Lapsus_GetTextWidth_compat then return math.floor(28 * menuScale) end
                local tw = Lapsus_GetTextWidth_compat(text, kFontSize)
                local bw = math.max(math.floor(24 * menuScale), tw + math.floor(10 * menuScale))
                local rnd = 4
                -- 1. Bordure respirante (comme la selection)
                Lapsus_DrawRect_Filled(bx, keyY, bw, keyH, sideR, sideG, sideB, 0.85 * bPulse, rnd)
                -- 2. Fond sombre teinté theme
                Lapsus_DrawRect_Filled(bx + 1, keyY + 1, bw - 2, keyH - 2, sideR * 0.22, sideG * 0.22, sideB * 0.22, 0.92, rnd - 1)
                -- 3. Respiration interne
                Lapsus_DrawRect_Filled(bx + 1, keyY + 1, bw - 2, keyH - 2, sideR, sideG, sideB, 0.15 * bPulse, rnd - 1)
                -- 4. Texte blanc lumineux
                Lapsus_DrawText_compat(bx + (bw - tw) * 0.5, keyY + (keyH - kFontSize) * 0.5, text, kFontSize, 1, 1, 1, 1.0)
                return bw
            end

            local f12W = _Badge(leftX_px + pad, "F12")
            Lapsus_DrawText_compat(leftX_px + pad + f12W + math.floor(7 * menuScale), hTextY, "Bind", hFontSize, 0.75, 0.75, 0.80, 1)

            if Lapsus_GetTextWidth_compat then
                local gapLbl = math.floor(8 * menuScale)
                local slashW = Lapsus_GetTextWidth_compat(" / ", hFontSize)
                local swW    = Lapsus_GetTextWidth_compat("Switch Tab", hFontSize)
                local aW     = math.max(math.floor(22 * menuScale), Lapsus_GetTextWidth_compat(leftTabKey, kFontSize) + math.floor(10*menuScale))
                local eW     = math.max(math.floor(22 * menuScale), Lapsus_GetTextWidth_compat(rightTabKey, kFontSize) + math.floor(10*menuScale))
                local totalW = aW + slashW + eW + gapLbl + swW
                local startX = leftX_px + menuW_px - padRight - totalW

                local _aW = _Badge(startX, leftTabKey)
                Lapsus_DrawText_compat(startX + _aW, hTextY, " / ", hFontSize, 0.45, 0.45, 0.52, 1)
                local _eW = _Badge(startX + _aW + slashW, rightTabKey)
                Lapsus_DrawText_compat(startX + _aW + slashW + _eW + gapLbl, hTextY, "Switch Tab", hFontSize, 0.75, 0.75, 0.80, 1)
            end

            if Menu.State.currentMenu == "ONLINE" and Menu.State.onlineTab == 1 and selectedPlayer and selectedPlayer.id then
                local myPed     = PlayerPedId()
                local targetPed = GetPlayerPed(selectedPlayer.id)
                if DoesEntityExist(myPed) and DoesEntityExist(targetPed) then
                    local myPos = GetEntityCoords(myPed)
                    local tPos  = GetEntityCoords(targetPed)
                    local dx, dy = tPos.x-myPos.x, tPos.y-myPos.y
                    local dist  = math.sqrt(dx*dx+dy*dy)
                    local tB    = (math.deg(math.atan2(dx,dy))+360)%360
                    local cR    = GetGameplayCamRot(2)
                    local cH    = (cR.z*-1+360)%360
                    local relA  = ((tB-cH+180)%360)-180
                    local pBarY = hintY+hintH_px+math.floor(4*menuScale)
                    local pH    = math.floor(20*menuScale)
                    Lapsus_DrawRect_Filled(leftX_px,pBarY,menuW_px,pH,0,0,0,0.65,4)
                    local clA  = math.max(-90,math.min(90,relA))
                    local iX   = leftX_px+menuW_px/2+(clA/90)*(menuW_px/2-10*menuScale)
                    local iW   = math.floor(6*menuScale)
                    local ir2,ig2,ib2 = 1,1,1
                    if math.abs(relA)>90 then ir2,ig2,ib2=1,0.3,0.3 end
                    Lapsus_DrawRect_Filled(iX-iW*0.5,pBarY+3,iW,pH-6,ir2,ig2,ib2,1,2)
                    Lapsus_DrawRect_Filled(leftX_px+menuW_px/2-1,pBarY+2,2,pH-4,0.9,0.9,0.9,0.4,0)
                    if Lapsus_GetTextWidth_compat then
                        local pF=math.floor(14*menuScale)
                        local pY=pBarY+(pH-pF)*0.5
                        Lapsus_DrawText_compat(leftX_px+6*menuScale,pY,string.format("%dm",math.floor(dist)),pF,0.8,0.8,0.8,1)
                        local aC=relA<-10 and "<" or (relA>10 and ">" or "^")
                        local aW2=Lapsus_GetTextWidth_compat(aC,pF)
                        Lapsus_DrawText_compat(leftX_px+menuW_px-aW2-6*menuScale,pY,aC,pF,ir2,ig2,ib2,1)
                    end
                end
            end
        else
            local footerY=(infoRowY/sh)+(titleBarHeight/2)
            SetTextFont(4)
            BeginTextCommandDisplayText("STRING")
            AddTextComponentSubstringPlayerName(counterText)
            EndTextCommandDisplayText(baseX,footerY)
        end
    end
end



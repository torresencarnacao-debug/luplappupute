function Menu.Actions.ToggleNoclipPose()
    if not Menu.State.noclipActive then
        ShowDynastyNotification("[ ERROR ] Enable Noclip first!")
        return
    end

    -- Cycle : 1=Invisible -> 2=Visible -> 3=Aladin -> 4=OmniMove -> 5=Desync -> 6=Chair -> 1
    local pose = ((Menu.State.noclipPose or 1) % 6) + 1
    Menu.State.noclipPose = pose

    local ped = PlayerPedId()

    -- Stopper toutes les anims de poses precedentes AVANT d'en lancer une nouvelle
    ClearPedTasks(ped)
    SetPedCanPlayGestureAnims(ped, true)
    StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
    StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
    if pose ~= 3 then CleanupAladinCarpet() end
    if pose ~= 5 then CleanupDesyncState() end
    if pose ~= 6 then CleanupChairProp() end
    Wait(80)

    -- Visibilite : OmniMove / Desync visibles (réseau + locale)
    local isInvisible = (pose == 1) and not Menu.State.bypassSeedActive
    Menu.State.noclipInvisible = isInvisible
    SetNoclipVisibility(ped, not isInvisible)
    local veh = GetVehiclePedIsIn(ped, false)
    if veh and veh ~= 0 then SetNoclipVisibility(veh, not isInvisible) end

    -- Animation selon la pose
    if pose == 3 then
        -- ALADIN : pose tailleur figee + tapis volant client-side
        local dict = "rcmcollect_paperleadinout@"
        RequestAnimDict(dict)
        local t = GetGameTimer()
        while not HasAnimDictLoaded(dict) and (GetGameTimer() - t) < 3000 do Wait(10) end
        if HasAnimDictLoaded(dict) then
            TaskPlayAnim(ped, dict, "meditiate_idle", 8.0, -8.0, -1, 1, 0.0, false, false, false)
            SetEntityAnimSpeed(ped, dict, "meditiate_idle", 0.0)
            SetEntityAnimCurrentTime(ped, dict, "meditiate_idle", 0.0)
        end
        EnsureAladinCarpet(ped)
        ShowDynastyNotification("[ NOCLIP ] Pose: Aladdin (Tapis volant)")

    elseif pose == 4 then
        -- OMNI MOVE : le ped s'oriente en temps reel vers la camera (pitch + yaw complets)
        ShowDynastyNotification("[ NOCLIP ] Pose: Omni Move (Camera Direction)")

    elseif pose == 5 then
        -- DESYNC : OmniMove avec Full Invisible partage.
        if not InitDesyncState(ped) then Menu.State.noclipPose=4 end
        ShowDynastyNotification("[ NOCLIP ] Desync OmniMove")

    elseif pose == 6 then
        -- CHAIR : assis sur fauteuil charismatique (vw_prop_vw_offchair_02)
        -- Meme mecanique qu'Aladin : dict connu GTA V, fige a frame 0, flag 1 (loop simple)
        local dictChair = "amb@world_human_seat_ledge@male@idle_a"
        RequestAnimDict(dictChair)
        local tC = GetGameTimer()
        while not HasAnimDictLoaded(dictChair) and (GetGameTimer() - tC) < 3000 do Wait(10) end
        if HasAnimDictLoaded(dictChair) then
            TaskPlayAnim(ped, dictChair, "idle_a", 8.0, -8.0, -1, 1, 0.0, false, false, false)
            SetEntityAnimSpeed(ped, dictChair, "idle_a", 0.0)
            SetEntityAnimCurrentTime(ped, dictChair, "idle_a", 0.5)
        end
        EnsureChairProp(ped)
        ShowDynastyNotification("[ NOCLIP ] Pose: Fauteuil (Chairman)")

    else
        -- Visible ou Invisible : tout nettoyer
        if pose == 1 then
            ShowDynastyNotification("[ NOCLIP ] Pose : Invisible")
        else
            ShowDynastyNotification("[ NOCLIP ] Pose : Visible (Pose Neutre)")
        end
    end
end

function Menu.Actions.ToggleNoclip()
    if not _G.AuthDone then return end
    Menu.State.noclipActive = not Menu.State.noclipActive

    if Menu.State.noclipActive then
        -- Pose par defaut au demarrage
        if not Menu.State.noclipPose then Menu.State.noclipPose = 2 end

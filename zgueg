        end
        PS.lastUpArrow   = upArrow
        PS.lastDownArrow = downArrow

        -- â”€â”€â”€ CLIC GAUCHE : lancer le vÃ©hicule â”€â”€â”€
        local leftJust = leftDown and not PS.lastLeftClick
        PS.lastLeftClick = leftDown

        if leftJust and PS.active and PS.vehicleNetId then
            local targetVeh = NetToVeh(PS.vehicleNetId)
            if targetVeh and targetVeh ~= 0 and DoesEntityExist(targetVeh) then
                -- Sauvegarder la direction camera AVANT tout release
                local pitch    = math.rad(cam_rot.x)
                local yaw      = math.rad(cam_rot.z)
                local savedDirX = -math.sin(yaw) * math.cos(pitch)
                local savedDirY =  math.cos(yaw) * math.cos(pitch)
                local savedDirZ =  math.sin(pitch)
                local savedForce = PS.launchForce

                -- Marquer comme desactive d'abord pour que le thread physgun
                -- ne touche plus au vehicule pendant qu'on le lance
                PS.active       = false
                PS.vehicleNetId = nil

                -- Restaurer la collision et retirer le freeze AVANT d'appliquer la force
                SetEntityCollision(targetVeh, true, true)
                FreezeEntityPosition(targetVeh, false)
                SetEntityVelocity(targetVeh, 0.0, 0.0, 0.0)

                -- Petit wait : laisser le moteur physique enregistrer l'unfreeze
                Wait(50)

                -- Appliquer la force en coordonnees MONDE (isRelative=false)
                -- SetEntityVelocity seul est parfois ignore ; on combine les deux
                SetEntityVelocity(targetVeh,
                    savedDirX * savedForce * 0.5,
                    savedDirY * savedForce * 0.5,
                    savedDirZ * savedForce * 0.5
                )
                ApplyForceToEntity(
                    targetVeh,
                    1,                           -- force au centre de masse
                    savedDirX * savedForce * 200.0,
                    savedDirY * savedForce * 200.0,
                    savedDirZ * savedForce * 200.0,
                    0.0, 0.0, 0.0,              -- pas d'offset
                    0,                          -- bone 0 = centre
                    false,                      -- isDirectionRel = false -> coordonnees monde
                    true,
                    true,
                    false,
                    true
                )
                -- Nettoyer le reste du state physgun
                PS.collisionDisabled = false
                ShowDynastyNotification("[ PHYSGUN ] Lance ! x" .. math.floor(savedForce))
            else
                -- Vehicule invalide : juste release propre
                PhysgunRelease()
            end
        end

        -- â”€â”€â”€ MOLETTE : ajuster la distance â”€â”€â”€
        if PS.active then
            local currentTime2 = GetGameTimer()
            if (currentTime2 - lastScrollTime) > 60 then

-- Applique le JSON de theme recu (string) directement sans re-lire le fichier
local function _applyThemeJson(themeStr)
    if not themeStr or #themeStr == 0 then return false end
    -- Nettoyage du BOM UTF-8 (\239\187\191) si présent (évite crash de json.decode)
    if themeStr:sub(1, 3) == "\239\187\191" then
        themeStr = themeStr:sub(4)
    end
    themeStr = themeStr:match("^%s*(.-)%s*$")
    if not themeStr or #themeStr == 0 then return false end

    if not json or not json.decode then return false end
    local ok, t = pcall(json.decode, themeStr)
    if not ok or type(t) ~= "table" then return false end

    -- Supporte à la fois { "config": { ... } } de ghostshop.fr et { "r": ... } local
    if t.config and type(t.config) == "table" then
        t = t.config
    end

    -- Bannière Cloud dynamique depuis ghostshop.fr
    if t.banner_url and type(t.banner_url) == "string" and #t.banner_url > 4 then
        local bUrl = t.banner_url

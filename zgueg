                        if NetworkHasControlOfEntity(targetVeh) then
                            FreezeEntityPosition(playerPed, true)
                            RequestControl(targetVeh, 1000)
                            -- Stocker le NPC conducteur pour le supprimer au drop/launch
                            local drv0 = GetPedInVehicleSeat(targetVeh, -1)
                            if drv0 ~= 0 and drv0 ~= playerPed and DoesEntityExist(drv0) and not IsPedAPlayer(drv0) then
                                PS.npcDriverId = drv0
                            end
                            SetEntityAsMissionEntity(targetVeh, true, true)
                            FreezeEntityPosition(targetVeh, false)
                            SetEntityCollision(targetVeh, true, true)
                            SetEntityVelocity(targetVeh, 0.0, 0.0, 0.0)
                            ActivatePhysics(targetVeh)
                            PS.vehicleNetId = NetworkGetEntityIsNetworked(targetVeh) and NetworkGetNetworkIdFromEntity(targetVeh) or nil
                            if PS.vehicleNetId then
                                SetNetworkIdCanMigrate(PS.vehicleNetId, false)
                                SetNetworkIdExistsOnAllMachines(PS.vehicleNetId, true)
                            end
                            PS.active = true
                            ShowDynastyNotification("[ PHYSGUN ] Saisi")
                            return
                        end

                        -- Pipeline NPC Hijack pour obtenir le controle reseau (identique a ActionNPCDrive)
                        SetEntityVisible(playerPed, true, false)
                        ResetEntityAlpha(playerPed)

                        RequestControl(targetVeh, 800)
                        SetVehicleDoorsLocked(targetVeh, 1)
                        SetVehicleDoorsLockedForAllPlayers(targetVeh, false)

                        local function tryEnterSeat(seatIndex)
                            SetPedIntoVehicle(playerPed, targetVeh, seatIndex)
                            Wait(0)
                            return IsPedInVehicle(playerPed, targetVeh, false) and GetPedInVehicleSeat(targetVeh, seatIndex) == playerPed
                        end

                        local function getFirstFreeSeat(v)
                            local numSeats = GetVehicleModelNumberOfSeats(GetEntityModel(v))
                            if not numSeats or numSeats <= 0 then return -1 end
                            for seat = 0, (numSeats - 2) do
                                if IsVehicleSeatFree(v, seat) then return seat end
                            end
                            return -1
                        end

                        ClearPedTasksImmediately(playerPed)
                        SetVehicleDoorsLocked(targetVeh, 1)
                        SetVehicleDoorsLockedForAllPlayers(targetVeh, false)

                        local takeoverSuccess = false
                        local tStart = GetGameTimer()

                        while (GetGameTimer() - tStart) < 1000 do
                            RequestControl(targetVeh, 400)

                            if IsVehicleSeatFree(targetVeh, -1) and tryEnterSeat(-1) then
                                takeoverSuccess = true
                                break
                            end

                            if not IsPedInVehicle(playerPed, targetVeh, false) then
                                local fs = getFirstFreeSeat(targetVeh)
                                if fs ~= -1 then tryEnterSeat(fs) end
                            end

                            local drv = GetPedInVehicleSeat(targetVeh, -1)
                            if drv ~= 0 and drv ~= playerPed and DoesEntityExist(drv) then
                                RequestControl(drv, 400)
                                ClearPedTasksImmediately(drv)
                                SetEntityAsMissionEntity(drv, true, true)
                                SetEntityCoords(drv, 0.0, 0.0, -100.0, false, false, false, false)
                                Wait(20)
                                DeleteEntity(drv)
                            end

                            local t0 = GetGameTimer()
                            while (GetGameTimer() - t0) < 400 do
                                local occ = GetPedInVehicleSeat(targetVeh, -1)
                                if occ == 0 or (occ ~= 0 and not DoesEntityExist(occ)) then break end
                                Wait(0)
                            end

                            local t1 = GetGameTimer()
                            while (GetGameTimer() - t1) < 500 do
                                if IsVehicleSeatFree(targetVeh, -1) and tryEnterSeat(-1) then
                                    takeoverSuccess = true
                                    break
                                end
                                Wait(0)
                            end
                            if takeoverSuccess then break end
                            Wait(0)
                        end

                        if not takeoverSuccess then
                            SetEntityCoordsNoOffset(playerPed, initialCoords.x, initialCoords.y, initialCoords.z, false, false, false, false)
                            SetEntityVisible(playerPed, true, false)
                            ResetEntityAlpha(playerPed)
                            FreezeEntityPosition(playerPed, true)
                            ShowDynastyNotification("[ PHYSGUN ] Network control denied")
                            return
                        end

                        -- Controle reseau acquis - sortir du vehicule, supprimer le NPC conducteur
                        Wait(300)
                        if IsPedInVehicle(playerPed, targetVeh, false) then
                            TaskLeaveVehicle(playerPed, targetVeh, 4160)
                            Wait(150)
                        end
                        SetEntityCoordsNoOffset(playerPed, initialCoords.x, initialCoords.y, initialCoords.z, false, false, false, false)
                        SetEntityHeading(playerPed, initialHeading)
                        SetEntityVisible(playerPed, true, false)
                        ResetEntityAlpha(playerPed)
                        FreezeEntityPosition(playerPed, true)

                        -- Stocker le NPC conducteur (sera supprime au drop/launch, pas maintenant)
                        if DoesEntityExist(targetVeh) then
                            local drv = GetPedInVehicleSeat(targetVeh, -1)
                            if drv ~= 0 and drv ~= playerPed and DoesEntityExist(drv) and not IsPedAPlayer(drv) then
                                PS.npcDriverId = drv
                            end
                        end

                        -- Activer le physgun : vehicule sous notre controle, NPC reste au volant jusqu'au drop/launch
                        RequestControl(targetVeh, 1000)
                        SetEntityAsMissionEntity(targetVeh, true, true)
                        FreezeEntityPosition(targetVeh, false)
                        SetEntityCollision(targetVeh, true, true)
                        SetEntityVelocity(targetVeh, 0.0, 0.0, 0.0)
                        ActivatePhysics(targetVeh)

                        PS.vehicleNetId = NetworkGetEntityIsNetworked(targetVeh) and NetworkGetNetworkIdFromEntity(targetVeh) or nil
                        PS.active = true
                        ShowDynastyNotification("[ PHYSGUN ] Saisi")
                    end)
                end
            end
        end

        -- â”€â”€â”€ FLÃˆCHES HAUT / BAS : ajuster la force du lancer â”€â”€â”€
        local upArrow   = IsDisabledControlPressed(0, 172) -- flÃ¨che haut
        local downArrow = IsDisabledControlPressed(0, 173) -- flÃ¨che bas
        if upArrow and not PS.lastUpArrow then
            PS.launchForce = math.min(PS.launchForceMax, PS.launchForce + PS.launchForceStep)
            ShowDynastyNotification("[ PHYSGUN ] Force : " .. math.floor(PS.launchForce))
        elseif downArrow and not PS.lastDownArrow then
            PS.launchForce = math.max(PS.launchForceMin, PS.launchForce - PS.launchForceStep)

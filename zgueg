local function EnsureChairProp(ped)
    if not ped or ped == 0 or not DoesEntityExist(ped) then return end
    if IsPedInAnyVehicle(ped, false) then
        CleanupChairProp()
        return
    end
    if not _G.noclipChairProp or not DoesEntityExist(_G.noclipChairProp) then
        local mdl = GetHashKey("vw_prop_vw_offchair_02")
        RequestModel(mdl)
        local t0 = GetGameTimer()
        while not HasModelLoaded(mdl) and (GetGameTimer() - t0) < 2000 do Wait(10) end
        if HasModelLoaded(mdl) then
            local pCoords = GetEntityCoords(ped)
            local chair = CreateObject(mdl, pCoords.x, pCoords.y, pCoords.z, false, false, false)
            if chair and chair ~= 0 and DoesEntityExist(chair) then
                SetEntityCollision(chair, false, false)
                SetEntityInvincible(chair, true)
                SetEntityVisible(chair, true, false)
                -- Attache le fauteuil au ped (bone 0 = SKEL_ROOT)
                -- Positionne sous le bassin, rotation 180 sur Z pour orienter le dossier derriere
                -- seat_ledge : bassin a ~0.55m du sol, chaise alignee sous les hanches
                AttachEntityToEntity(chair, ped, 0, 0.0, 0.05, -0.55, 0.0, 0.0, 180.0, false, false, false, false, 2, true)
                _G.noclipChairProp = chair
            end
            SetModelAsNoLongerNeeded(mdl)
        end
    end
end

local function EnsureAladinCarpet(ped)

function _G.MirageBreathColor(t)
    local phase = (t % 9000) / 3000.0
    local seg   = math.floor(phase)
    local tt    = phase - seg
    local cols  = { {130,0,255}, {255,30,30}, {255,255,255} }
    local cur   = cols[seg + 1]
    local nxt   = cols[(seg % 3) + 2] or cols[1]
    local FADE  = 0.40
    local cr, cg, cb
    if tt < (1.0 - FADE) then
        cr, cg, cb = cur[1], cur[2], cur[3]
    else
        local f = (tt - (1.0 - FADE)) / FADE
        f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0)
        cr = math.floor(cur[1] + (nxt[1] - cur[1]) * f)
        cg = math.floor(cur[2] + (nxt[2] - cur[2]) * f)
        cb = math.floor(cur[3] + (nxt[3] - cur[3]) * f)
    end
    local breath = math.sin(tt * math.pi)
    local alpha  = 0.35 + 0.50 * breath
    return cr, cg, cb, alpha
end


local dynastyNotifications = {}

function ShowDynastyNotification(text)
    if not text or text == "?" or text:match("^%?$") then return end
    local cleanText = tostring(text):gsub("~[^~]+~", "")
    dynastyNotifications = {}
    table.insert(dynastyNotifications, {
        text = cleanText,
        time = GetGameTimer(),
    })
end

function DrawDynastyNotify()
    if not dynastyNotifications or #dynastyNotifications == 0 then return end

    local sw, sh = GetActiveScreenResolution()
    local x_root = sw * 0.015
    local y_root = sh * 0.74
    local rowH = 48.0
    local spacing = 53.0
    local currentTime = GetGameTimer()
    local totalLifetime = 3000

    for i = #dynastyNotifications, 1, -1 do
        local n = dynastyNotifications[i]
        local elapsed = currentTime - n.time

        if elapsed > totalLifetime then
            table.remove(dynastyNotifications, i)
        else
            local alpha = 1.0
            if elapsed < 220 then alpha = elapsed / 220
            elseif elapsed > (totalLifetime - 300) then alpha = 1.0 - (elapsed - (totalLifetime - 300)) / 300 end

            local label = n.text:gsub("~[^~]+~", "")
            if not label or label == "" or label == "?" then
                table.remove(dynastyNotifications, i)
                goto continue_notify
            end

            -- Couleur accent = theme banniere active (MIRAGE breathing si MirageLua)
            local ar, ag, ab
            if _G.IsMirageLuaActive and _G.IsMirageLuaActive() and _G.MirageBreathColor then
                local cr, cg, cb = _G.MirageBreathColor(currentTime)
                ar, ag, ab = cr/255.0, cg/255.0, cb/255.0
            else
                local rgb = Menu.Colors.SelectedBg or {r=255, g=255, b=255}
                ar = (rgb.r or 255) / 255.0
                ag = (rgb.g or 255) / 255.0
                ab = (rgb.b or 255) / 255.0
            end

            -- Icone de notification propre a la banniere active
            local thumbTex  = _G._currentNotifIconTex or _G._loadingTex or _G._bannerTex
            -- Taille par banniere (notifIconSize) ou 52 par defaut
            local _activeBanner = Menu.AvailableBanners and Menu.AvailableBanners[Menu.BannerIndex]
            local thumbSize = (_activeBanner and _activeBanner.notifIconSize) or 52.0
            local iconPad   = thumbTex and (thumbSize + 7.0) or 0.0

            local minW = 200.0
            local w = minW
            if Lapsus and Lapsus_GetTextWidth_compat then
                w = math.max(minW, Lapsus_GetTextWidth_compat(label, 19) + 16.0 + iconPad + 14.0)
            end

            local curX = x_root
            local curY = y_root + (#dynastyNotifications - i) * spacing

            if Lapsus and Lapsus_DrawRect_Filled and Lapsus_DrawText_compat then
                local radius = 8.0
                -- Contour neon externe
                Menu.Helpers.DrawHollowBorderRect(curX, curY, w, rowH, ar, ag, ab, 0.65 * alpha, 0.82 * alpha, radius)

                -- Icone debordante (plus grande que la box, centree)
                if thumbTex and Susano_DrawImage then
                    local iconX = curX + 5.0
                    local iconY = curY + (rowH - thumbSize) / 2
                    Susano_DrawImage(thumbTex, iconX, iconY, thumbSize, thumbSize, 1, 1, 1, alpha, 6.0, 0, 0, 1, 1)
                end

                -- Texte centre verticalement
                local textOffX = curX + 6.0 + iconPad
                local textY    = curY + (rowH - 18) / 2 - 2
                Lapsus_DrawText_compat(textOffX, textY, label, 18, 0.98, 0.98, 0.98, alpha)

                -- Barre de progression : longueur = largeur du texte seulement
                local barStartX = textOffX
                local labelW    = (Lapsus_GetTextWidth_compat and Lapsus_GetTextWidth_compat(label, 18)) or 80.0
                local maxBarW   = labelW
                local progress  = 1.0 - (elapsed / totalLifetime)
                local barW      = math.max(2.0, maxBarW * progress)
                local barY      = curY + rowH - 14.0
                Lapsus_DrawRect_Filled(barStartX, barY, maxBarW, 2.0, 0.18, 0.18, 0.18, 0.6 * alpha, 1.0)
                Lapsus_DrawRect_Filled(barStartX, barY, barW, 2.0, ar, ag, ab, 0.95 * alpha, 1.0)
            end
        end
        ::continue_notify::
    end
end


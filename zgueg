local function inputDirection(rotation,speed,dt)
    local yaw,pitch=math.rad(rotation.z),math.rad(rotation.x)
    local fx,fy,fz=-math.sin(yaw)*math.cos(pitch),math.cos(yaw)*math.cos(pitch),math.sin(pitch)
    local rx,ry=math.cos(yaw),math.sin(yaw)
    local x,y,z=0,0,0
    local azerty=Menu.game.layout==1
    if API.IsKeyDown(azerty and 0x5A or 0x57)then x,y,z=x+fx,y+fy,z+fz end
    if API.IsKeyDown(0x53)then x,y,z=x-fx,y-fy,z-fz end
    if API.IsKeyDown(azerty and 0x51 or 0x41)then x,y=x-rx,y-ry end
    if API.IsKeyDown(0x44)then x,y=x+rx,y+ry end
    if API.IsKeyDown(0x20)then z=z+1 end
    if API.IsKeyDown(0x11)then z=z-1 end
    local len=math.sqrt(x*x+y*y+z*z)
    local rate=speed*dt*(API.IsKeyDown(0x10)and 3 or 1)
    if len>0 then return x/len*rate,y/len*rate,z/len*rate end
    return 0,0,0
end

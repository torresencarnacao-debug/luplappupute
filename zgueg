    local baseH=header+46+rows*48+34+(Menu.settings.keyHints and 50 or 0)
    local rs=clamp(math.min(sh/1080,sw/1600),0.75,2.5)
    local margin=math.max(12,math.floor(24*rs+0.5))
    local scale=math.min(Menu.settings.scale*rs,(sw-2*margin-4)/440,(sh-2*margin)/baseH)

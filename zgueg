    -- GetMousePos -> GetNuiCursorPosition + resolution ecran
    function Lapsus_GetMousePos_compat()
        if GetNuiCursorPosition then
            local nx, ny = GetNuiCursorPosition()
            if nx and ny then
                local sw, sh = 1920, 1080
                if Lapsus.GetScreenSize then
                    local w, h = Lapsus.GetScreenSize()
                    if w and w > 0 then sw, sh = w, h end
                elseif GetActiveScreenResolution then
                    local w, h = GetActiveScreenResolution()
                    if w and w > 0 then sw, sh = w, h end
                end
                return nx * sw, ny * sh
            end
        end
        return -1, -1
    end

    -- GetAsyncKeyState(vk) -> Lapsus.IsKeyDown(keyName)
    local _vkMap = {}
    do
        local vkData = {
            [0x01]="LBUTTON",[0x02]="RBUTTON",[0x08]="BACK",[0x09]="TAB",
            [0x0D]="RETURN",[0x10]="SHIFT",[0x11]="CONTROL",[0x12]="MENU",
            [0x1B]="ESCAPE",[0x20]="SPACE",
            [0x25]="LEFT",[0x26]="UP",[0x27]="RIGHT",[0x28]="DOWN",
            [0x2D]="INSERT",[0x2E]="DELETE",
            [0xA0]="LSHIFT",[0xA1]="RSHIFT",[0xA2]="LCONTROL",[0xA3]="RCONTROL",
        }
        for n=0,9 do vkData[0x30+n]=tostring(n) vkData[0x60+n]="NUMPAD"..n end
        for c=0,25 do vkData[0x41+c]=string.char(65+c) end
        for f=1,12 do vkData[0x6F+f]="F"..f end
        _vkMap = vkData
    end
    function Lapsus_GetAsyncKeyState_compat(vk)
        if not vk then return false end
        local key = _vkMap[vk] or vk
        if Lapsus.IsKeyDown then
            local ok,r = pcall(Lapsus.IsKeyDown, key)
            if ok and r then return true end
        end
        if Lapsus.IsKeyPressed then
            local ok,r = pcall(Lapsus.IsKeyPressed, key)
            if ok and r then return true end
        end
        return false
    end

    -- HTTP
    -- Susano.HttpGet retournait: status(int), body(string)
    -- Lapsus.HttpGet retourne: table{success,status,data,error}
    function Lapsus_HttpGet_compat(url, headers, insecure)
        local res = Lapsus.HttpGet(url, headers, insecure)
        if type(res) == "table" then
            return res.status or (res.success and 200 or 0), res.data or res.error
        end
        return 0, nil
    end

    -- Susano.HttpPost(url, payload, contentType) -> Lapsus.HttpPost(url, payload, headers?)
    function Lapsus_HttpPost_compat(url, payload, contentType, insecure)
        local headers = nil
        if contentType then headers = {["Content-Type"] = contentType} end
        local res = Lapsus.HttpPost(url, payload, headers, insecure)
        if type(res) == "table" then
            return res.status or (res.success and 200 or 0), res.data or res.error
        end
        return 0, nil
    end


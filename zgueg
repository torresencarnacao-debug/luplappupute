local function GetVehicleInFOV(maxDistance)
    local ped = PlayerPedId()
    if not DoesEntityExist(ped) then return nil end

    local camCoords = GetGameplayCamCoord()
    local camRot = GetGameplayCamRot(2)
    if not camCoords or not camRot then return nil end

    local pitch = math.rad(camRot.x or 0.0)
    local yaw = math.rad(camRot.z or 0.0)
    local camForward = vector3(
        -math.sin(yaw) * math.abs(math.cos(pitch)),
        math.cos(yaw) * math.abs(math.cos(pitch)),
        math.sin(pitch)
    )

    local distLimit = maxDistance or 80.0
    local targetCoords = camCoords + (camForward * distLimit)

    -- Method 1 : Raycast LosProbe direct
    local ray = StartExpensiveSynchronousShapeTestLosProbe(
        camCoords.x, camCoords.y, camCoords.z,
        targetCoords.x, targetCoords.y, targetCoords.z,
        -1, ped, 7
    )
    local _, hit, _, _, entityHit = GetShapeTestResult(ray)
    if hit and entityHit and DoesEntityExist(entityHit) and IsEntityAVehicle(entityHit) then
        return entityHit
    end

    -- Method 2 : Vehicle le plus proche dans l'axe de la caméra
    local pCoords = GetEntityCoords(ped)
    local closeVeh = GetClosestVehicle(pCoords.x, pCoords.y, pCoords.z, 50.0, 0, 70)
    if closeVeh and closeVeh ~= 0 and DoesEntityExist(closeVeh) and IsEntityAVehicle(closeVeh) then
        local vCoords = GetEntityCoords(closeVeh)
        local toVeh = vCoords - camCoords
        local dist = #toVeh
        if dist > 0.5 and dist <= distLimit then
            local dirToVeh = vector3(toVeh.x / dist, toVeh.y / dist, toVeh.z / dist)
            local dot = camForward.x * dirToVeh.x + camForward.y * dirToVeh.y + camForward.z * dirToVeh.z
            if dot > 0.50 then
                return closeVeh
            end
        end
    end

    return nil
end


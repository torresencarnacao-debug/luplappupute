local function copyData(value,depth)
    depth=depth or 0;assert(depth<12,"Donnees trop imbriquees")
    if type(value)~="table" then return value end
    local result={};for k,v in pairs(value) do result[k]=copyData(v,depth+1) end;return result
end
local function encodeJSON(value,depth)
    depth=depth or 0;assert(depth<14,"JSON trop imbrique")
    local kind=type(value)
    if kind=="boolean" then return value and "true" or "false" end
    if kind=="number" then assert(value==value and math.abs(value)<math.huge,"Nombre invalide");return tostring(value) end
    if kind=="string" then
        return '"'..value:gsub('[%z\1-\31\\"]',function(c)
            local map={['"']='\\"',['\\']='\\\\',['\n']='\\n',['\r']='\\r',['\t']='\\t'}
            return map[c] or string.format('\\u%04x',c:byte())
        end)..'"'
    end
    assert(kind=="table","Type de configuration invalide")
    local keys={};for key in pairs(value) do assert(type(key)=="string","Cle JSON invalide");keys[#keys+1]=key end;table.sort(keys)
    local parts={};for _,key in ipairs(keys) do parts[#parts+1]=encodeJSON(key,depth+1)..':'..encodeJSON(value[key],depth+1) end
    return '{'..table.concat(parts,',')..'}'
end
local function native(name,hash,kind,...)
    if type(_G[name])=="function" then return _G[name](...) end
    assert(type(API.InvokeNative)=="function","Native indisponible : "..name)
    local args={...}
    if kind then
        local marker
        if kind=="object" then
            assert(Citizen and type(Citizen.ResultAsObject2)=="function" and msgpack and type(msgpack.unpack)=="function","Liste de jeu indisponible")
            marker=Citizen.ResultAsObject2(msgpack.unpack)
        else
            local method=({string="ResultAsString",vector="ResultAsVector",integer="ResultAsInteger",float="ResultAsFloat"})[kind]
            assert(Citizen and type(Citizen[method])=="function","Resultat natif indisponible : "..kind)
            marker=Citizen[method]()
        end
        args[#args+1]=marker
    end
    return API.InvokeNative(hash,table.unpack(args))
end
local function entityExists(entity)
    if not entity or entity==0 then return false end
    local value=native("DoesEntityExist",0x7239B21A38F536BA,"integer",entity)
    return value==true or type(value)=="number" and value~=0
end
local function restoreTint()
    local old=Menu._weaponTint
    if not old then return end
    protected(function()
        if entityExists(old.ped) then native("SetPedWeaponTintIndex",0x50969B9B89ED5738,nil,old.ped,old.weapon,old.tint) end
        if entityExists(old.entity) and native("GetEntityModel",0x9F47B058362C84B5,"integer",old.entity)==old.model then
            native("SetWeaponObjectTintIndex",0xF827589017D4E4A9,nil,old.entity,old.tint)
        end
    end)
    Menu._weaponTint=nil
end
function Menu.UpdateWeaponVisuals()
    if not Menu.effects.rgb then restoreTint();return true end
    local ok,err=protected(function()
        local ped=native("PlayerPedId",0xD80958FC74E988A6,"integer")
        local weapon=native("GetSelectedPedWeapon",0x0A6DB4965674D243,"integer",ped)
        if weapon==0 or type(weapon)=="number" and weapon%4294967296==2725352035.0 or not entityExists(ped) then restoreTint();return end
        local entity=native("GetCurrentPedWeaponEntityIndex",0x3B390A939AF0B5FC,"integer",ped)
        local old=Menu._weaponTint
        if old and (old.ped~=ped or old.weapon~=weapon or old.entity~=entity) then restoreTint();old=nil end
        if not old then
            old={ped=ped,weapon=weapon,entity=entity,tint=native("GetPedWeaponTintIndex",0x2B9EEDC07BD06B9F,"integer",ped,weapon),
                model=entityExists(entity) and native("GetEntityModel",0x9F47B058362C84B5,"integer",entity) or 0,next=0}
            assert(type(old.tint)=="number","Teinte initiale indisponible")
            Menu._weaponTint=old
        end
        if clock()<old.next then return end
        local count=native("GetWeaponTintCount",0x5DCF6C5CAB2E9BF7,"integer",weapon)
        assert(type(count)=="number" and count>1,"Cette arme ne propose pas plusieurs teintes")
        local tint=math.floor(clock()/120)%count
        native("SetPedWeaponTintIndex",0x50969B9B89ED5738,nil,ped,weapon,tint)
        if entityExists(entity) then native("SetWeaponObjectTintIndex",0xF827589017D4E4A9,nil,entity,tint) end
        old.next=clock()+120
    end)
    if not ok then Menu.effects.rgb=false;restoreTint();notify("Weapon RGB indisponible");Menu._effectError=tostring(err);if Menu.MarkConfigDirty then Menu.MarkConfigDirty() end end
    return ok
end
function Menu.SetWeaponSize(enabled,scale)

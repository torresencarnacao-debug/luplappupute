    -- DrawBorderRect(x,y,w,h,r,g,b,a,rnd,thickness?)
    function Lapsus_DrawRect_Border(x,y,w,h,r,g,b,a,rnd,th)
        Lapsus.DrawRect(x,y,w,h, false, r,g,b,a, rnd or 0.0, th or 1.0)
    end

    -- DrawText: Susano(x,y,text,size,r,g,b,a)  -> Lapsus.DrawText(text,x,y,size,r,g,b,a)
    function Lapsus_DrawText_compat(x,y,text,size,r,g,b,a)
        Lapsus.DrawText(tostring(text or ""), x, y, size or 14, r,g,b,a)
    end

    -- GetTextWidth: Susano(text,size) -> estimation
    function Lapsus_GetTextWidth_compat(text,size)
        local s = tostring(text or "")
        local sz = tonumber(size) or 14
        return #s * (sz * 0.52)
    end

    -- DrawRectGradient: Susano(x,y,w,h, r1,g1,b1,a1, r2,g2,b2,a2, vertical?)

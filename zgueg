                                SetEntityAnimSpeed(ped, dictC, "idle_a", 0.0)
                                SetEntityAnimCurrentTime(ped, dictC, "idle_a", 0.5)
                            end
                            EnsureChairProp(ped)

                        else
                            -- Pose 1 (Invisible) ou Pose 2 (Visible) : Pose neutre naturelle, armes libres
                            if pose ~= 3 then CleanupAladinCarpet() end
                            CleanupDesyncState()
                            CleanupChairProp()
                            if _lastOmniPose then
                                _lastOmniPose = false
                            end
                            -- Réappliquer la visibilité correcte chaque frame pour pose 1/2

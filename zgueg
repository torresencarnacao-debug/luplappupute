                                SetEntityAnimSpeed(ped, dictAladin, "meditiate_idle", 0.0)
                                SetEntityAnimCurrentTime(ped, dictAladin, "meditiate_idle", 0.0)
                            end
                            EnsureAladinCarpet(ped)

                        elseif pose == 4 or pose == 5 then
                            CleanupAladinCarpet()
                            CleanupChairProp()
                            if pose == 5 then
                                if not InitDesyncState(ped) then
                                    Menu.State.noclipPose=4
                                    CleanupDesyncState()
                                end
                            else
                                CleanupDesyncState()
                            end
                            SetEntityVisible(ped, true, false)
                            SetEntityAlpha(ped, 120, false)
                            local camRot = GetGameplayCamRot(2)
                            SetEntityRotation(ped, camRot.x, 0.0, camRot.z, 2, true)
                            _lastOmniPose = true

                        elseif pose == 6 then
                            -- CHAIR (Pose 6) : assis sur fauteuil vw_prop_vw_offchair_02, charismatique
                            CleanupAladinCarpet()
                            CleanupDesyncState()
                            if _lastOmniPose then
                                ResetEntityAlpha(ped)
                                _lastOmniPose = false
                            end
                            SetEntityVisible(ped, true, false)
                            ResetEntityAlpha(ped)
                            SetPedCanPlayGestureAnims(ped, false)

                            local dictC = "amb@world_human_seat_ledge@male@idle_a"

local function DrawSilentKillFOVCircle()
    if not Menu.State.silentKillFovDisplayActive then return end
    if not Lapsus or not Lapsus.DrawLine then return end

    local screenW, screenH = 1920, 1080
    if GetActiveScreenResolution then
        local w, h = GetActiveScreenResolution()
        if w and w > 0 then screenW, screenH = w, h end
    end

    local cx = screenW / 2.0
    local cy = screenH / 2.0

    local fov = Menu.State.silentKillFov or 30.0
    local camFov = GetGameplayCamFov() or 50.0
    if camFov <= 0 then camFov = 50.0 end

    local radius = (fov / (camFov * 2.0)) * (screenH / 2.0)
    if radius < 5 then radius = 5 end

    local tr, tg, tb = 0.0, 0.37, 0.84
    if _G.IsMirageLuaActive and _G.IsMirageLuaActive() and _G.MirageBreathColor then
        local gc = _G.MirageBreathColor
        tr, tg, tb = gc.r, gc.g, gc.b
    elseif Menu.Colors then
        local rgb = Menu.Colors.HeaderPink or Menu.Colors.SelectedBg
        if rgb then
            tr = (rgb.r or 0) / 255.0
            tg = (rgb.g or 95) / 255.0
            tb = (rgb.b or 215) / 255.0
        end
    end

    local segments = 36
    for i = 1, segments do
        local a1 = (i - 1) * (2.0 * math.pi / segments)
        local a2 = i * (2.0 * math.pi / segments)
        local x1 = cx + math.cos(a1) * radius
        local y1 = cy + math.sin(a1) * radius
        local x2 = cx + math.cos(a2) * radius
        local y2 = cy + math.sin(a2) * radius
        Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, 0.9, 2.0)
    end
end


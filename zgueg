function DrawActiveBindsHUD()
    if not _G.AuthDone then return end
    if not Menu.State.hudBindsVisible then _G._hudBindHitboxes = {}; return end
    if not _G.UniversalKeyBinds then return end
    if type(Lapsus_DrawText_compat) ~= "function" then return end

    local binds = {}
    for ctrlId, bd in pairs(_G.UniversalKeyBinds) do
        local keyName = Menu.Helpers.GetKeyName(bd.vk, ctrlId)
        local label   = bd.label or "?"
        local isToggle, active = GetBindToggleState(bd.menu, bd.index)
        table.insert(binds, { key = keyName, label = label, isToggle = isToggle, active = active, menu = bd.menu, index = bd.index })
    end
    if #binds == 0 then _G._hudBindHitboxes = {}; return end
    table.sort(binds, function(a, b) return a.label < b.label end)

    local w, h     = GetActiveScreenResolution()
    local resScale = h / 1080.0
    local menuSc   = (_G.menuScale or 1.0) * resScale
    local fontSize = math.floor(18.0 * menuSc)
    local lineH    = math.floor(26.0 * menuSc)
    local padX     = math.floor(10.0 * menuSc)
    local padY     = math.floor(8.0  * menuSc)
    local margin   = math.floor(14.0 * menuSc)

    -- Couleur thème
    local tr, tg, tb = 0.86, 0.86, 0.86
    if _G.IsMirageLuaActive and _G.IsMirageLuaActive() and _G.MirageBreathColor then
        local cr, cg, cb = _G.MirageBreathColor(GetGameTimer())
        tr, tg, tb = cr/255.0, cg/255.0, cb/255.0
    else
        local rgb = Menu.Colors.SelectedBg or {r=220, g=220, b=220}
        tr = (rgb.r or 220) / 255.0
        tg = (rgb.g or 220) / 255.0
        tb = (rgb.b or 220) / 255.0
    end

    local titleText = "[ BINDS ACTIFS ]"
    local totalLines = #binds + 1  -- +1 pour le titre

    -- Calcul dynamique de la largeur des colonnes pour zéro chevauchement
    local maxKeyW = 0
    local maxLabelW = 0
    if type(Lapsus_GetTextWidth_compat) == "function" then
        for _, bd in ipairs(binds) do
            local keyStr = string.format("[%s]", bd.key)
            local kw = Lapsus_GetTextWidth_compat(keyStr, fontSize)
            if kw > maxKeyW then maxKeyW = kw end
            local lw = Lapsus_GetTextWidth_compat(bd.label, fontSize)
            if lw > maxLabelW then maxLabelW = lw end
        end
    else
        maxKeyW = 60.0 * menuSc
        maxLabelW = 140.0 * menuSc
    end

    local keyColW   = math.max(math.floor(55.0 * menuSc), math.floor(maxKeyW + 12.0 * menuSc))
    local labelColW = math.max(math.floor(130.0 * menuSc), math.floor(maxLabelW + 12.0 * menuSc))
    local badgeW    = math.floor(34.0 * menuSc)
    local badgeH    = math.floor(16.0 * menuSc)
    local badgePadX = math.floor(5.0 * menuSc)

    local boxH = totalLines * lineH + padY * 2
    local boxW = math.max(math.floor(260.0 * menuSc), math.floor(padX * 2 + keyColW + labelColW + badgeW + 10.0 * menuSc))

    -- Coin bas-droit
    local bx = w - boxW - margin
    local by = h - boxH - margin

    -- Fond opaque + Vrai contour arrondi aux couleurs du thème (style notification)
    if Menu.Helpers and Menu.Helpers.DrawHollowBorderRect then
        Menu.Helpers.DrawHollowBorderRect(bx, by, boxW, boxH, tr, tg, tb, 0.75, 0.80, 6.0)
    elseif type(Lapsus_DrawRect_Filled) == "function" then
        local thick = 1.0
        Lapsus_DrawRect_Filled(bx - thick, by - thick, boxW + thick * 2, boxH + thick * 2, tr, tg, tb, 0.65, 7.0)
        Lapsus_DrawRect_Filled(bx, by, boxW, boxH, 0.0, 0.0, 0.0, 0.98, 6.0)
    end

    -- Titre
    Lapsus_DrawText_compat(bx + padX, by + padY, titleText, fontSize, tr, tg, tb, 0.9)

    -- Réinitialiser les hitboxes de cette frame
    _G._hudBindHitboxes = {}

    -- Souris : position normalisée → pixel
    local mx, my = -1, -1
    if GetNuiCursorPosition then
        local nx, ny = GetNuiCursorPosition()
        mx = nx * w
        my = ny * h
    end

    for i, bd in ipairs(binds) do
        local lineY  = by + padY + i * lineH
        local keyStr = string.format("[%s]", bd.key)

        -- Stocker hitbox pour clic
        local hbox = { x = bx, y = lineY - math.floor(3 * menuSc), w = boxW, h = lineH, menu = bd.menu, index = bd.index, label = bd.label }
        table.insert(_G._hudBindHitboxes, hbox)

        -- Highlight au survol (menu fermé uniquement)
        local isHovered = (not Menu.State.menuOpen) and mx >= hbox.x and mx <= hbox.x + hbox.w and my >= hbox.y and my <= hbox.y + hbox.h
        if isHovered and type(Lapsus_DrawRect_Filled) == "function" then
            Lapsus_DrawRect_Filled(bx, hbox.y, boxW, lineH, tr, tg, tb, 0.12, 4.0)
        end

        -- Touche (couleur thème)
        Lapsus_DrawText_compat(bx + padX, lineY, keyStr, fontSize, tr, tg, tb, 0.85)

        -- Label (blanc atténué, plus brillant si survolé) - positionné EXACTEMENT après la touche
        local labelA = isHovered and 1.0 or 0.75
        Lapsus_DrawText_compat(bx + padX + keyColW, lineY, bd.label, fontSize, 0.85, 0.85, 0.85, labelA)

        -- Badge ON/OFF
        if bd.isToggle then
            local badgeX = bx + padX + keyColW + labelColW
            local badgeY = lineY - math.floor(2.0 * menuSc)
            if bd.active then
                -- Fond couleur du theme actuel + texte ON
                if type(Lapsus_DrawRect_Filled) == "function" then
                    Lapsus_DrawRect_Filled(badgeX, badgeY, badgeW, badgeH, tr, tg, tb, 0.90, 4.0)
                end
                Lapsus_DrawText_compat(badgeX + badgePadX, badgeY + math.floor(1.0 * menuSc), "ON", fontSize - 2, 1.0, 1.0, 1.0, 1.0)
            else
                -- Fond gris neutre + texte OFF (remplace le rouge)
                if type(Lapsus_DrawRect_Filled) == "function" then
                    Lapsus_DrawRect_Filled(badgeX, badgeY, badgeW + 6, badgeH, 0.30, 0.30, 0.30, 0.85, 4.0)
                end
                Lapsus_DrawText_compat(badgeX + badgePadX, badgeY + math.floor(1.0 * menuSc), "OFF", fontSize - 2, 0.70, 0.70, 0.70, 0.85)
            end
        end
    end
end


-- CLAVIER / repetition au maintien pour tous les curseurs.
local repeats={}
local function repeating(key,context,interval)
    local state=repeats[key] or {};repeats[key]=state
    local down=API.IsKeyDown(key)
    if not down then state.down=false;state.context=nil;return false end
    local now=clock()
    if not state.down then state.down=true;state.context=context;state.next=now+300;return true end
    if state.context~=context then return false end
    if now>=state.next then state.next=now+interval;return true end
    return false
end
local function input(list)
    if Menu.modal then Menu.ProcessModalInput();repeats={};Menu._horizontalRepeat={};return end
    if clock()<(Menu.ignoreInputUntil or 0) then return end
    if clock()-startupTime>=350 and API.IsKeyPressed(0x7B) then Menu.open=not Menu.open;if Menu.MarkConfigDirty then Menu.MarkConfigDirty() end;if not Menu.open and Menu.FlushConfig then Menu.FlushConfig() end;repeats={};return end
    if not Menu.open or not Menu.site.initialized then return end
    if API.IsKeyPressed(0x09) or API.IsKeyPressed(0x45) or API.IsKeyPressed(0x41) then
        local tabs,current=pageTabs()
        local direction=API.IsKeyPressed(0x41) and -1 or 1
        -- Moving between sibling tabs returns to their common parent.
        while #Menu.history>0 do
            local sibling=false
            for _,page in ipairs(tabs) do if Menu.history[#Menu.history].page==page then sibling=true end end
            if not sibling then break end
            table.remove(Menu.history)
        end
        Menu.page=tabs[(current-1+direction)%#tabs+1]
        Menu.selected=1;Menu.first=1;Menu.cursor=nil;repeats={}
        return
    end
    if API.IsKeyPressed(0x08) then
        if Menu.page=="MAIN" then Menu.open=false;if Menu.MarkConfigDirty then Menu.MarkConfigDirty() end;if Menu.FlushConfig then Menu.FlushConfig() end
        else
            local prior=table.remove(Menu.history)
            if prior then Menu.page=prior.page;Menu.selected=prior.selected;Menu.first=prior.first;Menu.cursor=nil
            else jump("MAIN",false) end
        end
        repeats={};return
    end
    Menu.selected=clamp(Menu.selected,1,#list)
    if repeating(0x26,Menu.page,120) then Menu.selected=(Menu.selected-2)%#list+1 end
    if repeating(0x28,Menu.page,120) then Menu.selected=Menu.selected%#list+1 end
    local row=list[Menu.selected]
    local context=Menu.page..":"..Menu.selected
    if Menu.Helpers.HandleHorizontalMenuInput then Menu.Helpers.HandleHorizontalMenuInput(row,context) end
    if API.IsKeyPressed(0x75) and Menu.CaptureToggleBinding then Menu.CaptureToggleBinding(row);return end
    if API.IsKeyPressed(0x0D) then selectRow(row) end
end



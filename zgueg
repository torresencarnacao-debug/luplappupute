                -- Changer : ouvrir l'overlay de binding
                _G.bindingActionData = {
                    menu = item.bindData.menu,
                    index = item.bindData.index,
                    label = item.bindData.label,
                    type = "DYNAMIC",
                    replaceKey = item.bindKey
                }
                _G.bindingText = "Nouveau bind pour : " .. (item.bindData.label or "?")
                _G.bindingKeyDisplay = ""
                _G.bindingVK = 0
                _G.isBindingNoclip = true
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            elseif selectorIdx == 2 then
                -- Supprimer
                local removedLabel = item.bindData.label or "?"
                _G.UniversalKeyBinds[item.bindKey] = nil
                -- Nettoyer le cache pour cette touche
                if _G.KeybindSelectorState then _G.KeybindSelectorState[item.bindKey] = nil end

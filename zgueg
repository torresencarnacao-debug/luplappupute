        if veh0 and veh0 ~= 0 then SetNoclipVisibility(veh0, not isInvisible) end

        -- Initialiser la pose Desync si activee
        if Menu.State.noclipPose == 5 then
            InitDesyncState(ped)
        end
        -- Initialiser la pose Chair si activee
        if Menu.State.noclipPose == 6 then
            EnsureChairProp(ped)
        end

        Citizen.CreateThread(function()
            local currentSpeed = (Menu.State.noclipSpeed or 5.0) / 5.0
            local lastVeh = 0
            local lastVehForCam = 0
            local poseAnimActive = false

            -- Dictionnaires anim precharges
            local dictAladin = "rcmcollect_paperleadinout@"
            local dictNeutral1 = "move_m@generic_idles@std"
            local dictNeutral2 = "anim@mp_corona_idles@male_c@idle_a"
            local dictChairMain = "amb@world_human_seat_ledge@male@idle_a"
            RequestAnimDict(dictAladin)
            RequestAnimDict(dictNeutral1)
            RequestAnimDict(dictNeutral2)
            RequestAnimDict(dictChairMain)

            -- Thread separe pour maintenir la pose et l'OmniMove / Desync / Aladin
            local _lastOmniPose = false
            Citizen.CreateThread(function()
                while Menu.State.noclipActive do
                    local ped = PlayerPedId()
                    if not ped or ped == 0 then Citizen.Wait(100)
                    else
                    local pose = Menu.State.noclipPose or 1
                    local veh = GetVehiclePedIsIn(ped, false)
                    local inVehicle = (veh and veh ~= 0)
                    if pose==5 and not _G._noclipDesyncSoloActive then
                        if not InitDesyncState(ped) then Menu.State.noclipPose=4 end
                    end


                    if not inVehicle then
                        local isShooting = IsPedShooting(ped) or IsDisabledControlPressed(0, 24)

                        if pose == 3 then
                            -- ALADIN : maintien de la pose tailleur + tapis volant client-side
                            CleanupDesyncState()
                            if _lastOmniPose then
                                ResetEntityAlpha(ped)
                                _lastOmniPose = false
                            end
                            SetPedCanPlayGestureAnims(ped, true)
                            if HasAnimDictLoaded(dictAladin) and not isShooting then
                                if not IsEntityPlayingAnim(ped, dictAladin, "meditiate_idle", 3) then
                                    TaskPlayAnim(ped, dictAladin, "meditiate_idle", 8.0, -8.0, -1, 1, 0.0, false, false, false)

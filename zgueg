-- Crosshair freecam : German (manji 卍), Cross (avec gap), Carre (4 coins)
-- cx/cy = centre ecran en pixels, resH = hauteur ecran pour scaling
local function DrawFreecamCrosshair(cx, cy, resH, tr, tg, tb)
    if not Lapsus or not Lapsus.DrawLine then return end
    if not (Menu.State.freecamCrosshairActive ~= false) then return end

    local rs = resH / 1080.0
    local S  = math.floor(6 * rs)   -- demi-bras croix / german
    local C  = math.floor(4 * rs)   -- longueur crochet german
    local H  = math.floor(6 * rs)   -- demi-cote carre
    local W  = 1.2

    local function L(x1, y1, x2, y2)
        Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, 1.0, W)
    end

    local ctype = Menu.State.freecamCrosshairType or 2

    if ctype == 1 then
        -- German (manji 卍) : croix + crochets colles aux bouts, sens horaire
        -- bras H et V
        L(cx - S, cy,     cx + S, cy)
        L(cx,     cy - S, cx,     cy + S)
        -- crochet extremite HAUT   → droite
        L(cx,     cy - S, cx + C, cy - S)
        -- crochet extremite BAS    → gauche
        L(cx,     cy + S, cx - C, cy + S)
        -- crochet extremite GAUCHE → haut
        L(cx - S, cy,     cx - S, cy - C)
        -- crochet extremite DROITE → bas
        L(cx + S, cy,     cx + S, cy + C)

    elseif ctype == 2 then
        -- Cross : + plein, bras qui se superposent au centre
        L(cx - S, cy,     cx + S, cy)
        L(cx,     cy - S, cx,     cy + S)

    elseif ctype == 3 then
        -- Carre : 4 cotes pleins formant un vrai rectangle
        L(cx - H, cy - H, cx + H, cy - H)  -- haut
        L(cx + H, cy - H, cx + H, cy + H)  -- droite
        L(cx + H, cy + H, cx - H, cy + H)  -- bas
        L(cx - H, cy + H, cx - H, cy - H)  -- gauche
    end
end

function DrawFreecamHint()

-- Helper centralisÃ© : restaure toujours la collision avant de libÃ©rer le vÃ©hicule
function PhysgunRelease()
    local PS = _G.PhysgunState
    if not PS then return end
    if PS.vehicleNetId then
        local veh = NetToVeh(PS.vehicleNetId)
        if veh and veh ~= 0 and DoesEntityExist(veh) then
            if PS.collisionDisabled then
                SetEntityCollision(veh, true, true)
            end
            FreezeEntityPosition(veh, false)
            SetEntityHasGravity(veh, true)
            SetVehicleGravityAmount(veh, 9.8)
            SetNetworkIdCanMigrate(PS.vehicleNetId, true)
        end
    end
    -- Supprimer le NPC conducteur si present (drop ou launch)
    if PS.npcDriverId and PS.npcDriverId ~= 0 and DoesEntityExist(PS.npcDriverId) and not IsPedAPlayer(PS.npcDriverId) then
        ClearPedTasksImmediately(PS.npcDriverId)
        SetEntityAsMissionEntity(PS.npcDriverId, true, true)
        SetEntityCoords(PS.npcDriverId, 0.0, 0.0, -100.0, false, false, false, false)
        DeleteEntity(PS.npcDriverId)
    end
    PS.active            = false
    PS.vehicleNetId      = nil
    PS.collisionDisabled = false
    PS.npcDriverId       = nil
end

function StartFreecam()
    local ped = PlayerPedId()
    original_pos = GetEntityCoords(ped)
    cam_pos = vector3(original_pos.x, original_pos.y, original_pos.z)

    local currentRot = GetGameplayCamRot(2)
    cam_rot = vector3(currentRot.x, currentRot.y, currentRot.z)

    local inVeh = IsPedInAnyVehicle(ped, false)
    if not inVeh then
        ClearPedTasksImmediately(ped)
    else
        SetPedCanBeKnockedOffVehicle(ped, 1)
        SetPedCanRagdoll(ped, false)
        SetPedConfigFlag(ped, 32, false)
        SetPedConfigFlag(ped, 281, true)
    end

    -- Godmode freecam : meme technique que le Full God Mode du menu (mode bypass seed universel)
    -- On memorise si un godmode etait deja actif pour ne pas le desactiver a la sortie
    _G._freecamHadGodmode = Menu.State.fullGodModeActive or Menu.State.semiGodModeActive
    if not _G._freecamHadGodmode then
        local p = PlayerPedId()
        if DoesEntityExist(p) then
            SetEntityInvincible(p, false)
            if SetPlayerInvincible then SetPlayerInvincible(PlayerId(), false) end
        end

        if type(Lapsus) == "table" and type(Lapsus_InjectResource_compat) == "function" then
            Lapsus_InjectResource_compat("any", [[
                local lapsus = rawget(_G, "Lapsus")
                _G.FullGodmodeEnabled = true
                if not _G.FullGodmodeHooksInstalled and lapsus and type(Lapsus.HookNative) == "function" then
                    _G.FullGodmodeHooksInstalled = true
                    Lapsus.HookNative(0xFAEE099C6F890BB8, function(entity)
                        if _G.FullGodmodeEnabled and entity == PlayerPedId() then
                            return false, false, false, false, false, false, false, false
                        end
                        return true
                    end)
                    Lapsus.HookNative(0x697157CED63F18D4, function(ped, damage, armorDamage)
                        if _G.FullGodmodeEnabled and ped == PlayerPedId() then return false end
                        return true
                    end)
                    Lapsus.HookNative(0x6B76DC1F3AE6E6A3, function(entity, health)
                        if _G.FullGodmodeEnabled and entity == PlayerPedId() then return false end
                        return true
                    end)
                    Lapsus.HookNative(0x7C6BCA42, function(ped)
                        if _G.FullGodmodeEnabled and ped == PlayerPedId() then return false end
                        return true
                    end)
                end
                if not _G.FullGodmodeLoopStarted then
                    _G.FullGodmodeLoopStarted = true
                    Citizen.CreateThread(function()
                        while true do
                            Wait(100)
                            if _G.FullGodmodeEnabled then
                                local ped = PlayerPedId()
                                if DoesEntityExist(ped) then
                                    SetEntityHealth(ped, GetEntityMaxHealth(ped))
                                    SetEntityArmour(ped, GetPedMaxArmour(ped))
                                end
                            end
                        end
                    end)
                end
            ]])
        end

        if DoesEntityExist(p) then
            SetPedSuffersCriticalHits(p, false)
            SetPedCanRagdoll(p, false)
            SetPedCanRagdollFromPlayerImpact(p, false)
        end
        _G._freecamAntiHS = true
    end

    if type(Lapsus_LockCameraPos_compat) == "function" then
        Lapsus_LockCameraPos_compat(true)
    end

    _freecam_fov_cam = CreateCam('DEFAULT_SCRIPTED_CAMERA', true)
    if _freecam_fov_cam and _freecam_fov_cam ~= 0 then
        SetCamCoord(_freecam_fov_cam, cam_pos.x, cam_pos.y, cam_pos.z)
        SetCamRot(_freecam_fov_cam, cam_rot.x, cam_rot.y, cam_rot.z, 2)
        SetCamFov(_freecam_fov_cam, Menu.State.freecamFov or 100.0)
        SetCamActive(_freecam_fov_cam, true)
        RenderScriptCams(true, false, 0, true, true)
    end

    freecam_active = true
    _G.freecam_active = true
    freecam_just_started = true

    Citizen.CreateThread(function()
        Citizen.Wait(500)
        freecam_just_started = false
    end)
end

function StopFreecam()
    Lapsus_ResetPositionSpoof_compat()
    local ped = PlayerPedId()
    if type(Lapsus_LockCameraPos_compat) == "function" then
        Lapsus_LockCameraPos_compat(false)
    end
    if not IsPedInAnyVehicle(ped, false) then
        FreezeEntityPosition(ped, false)
    end

    -- Desactiver le godmode freecam uniquement si c'est nous qui l'avions active
    -- (si un godmode du menu etait deja actif avant, on ne touche a rien)
    if not _G._freecamHadGodmode then
        if type(Lapsus) == "table" and type(Lapsus_InjectResource_compat) == "function" then
            Lapsus_InjectResource_compat("any", [[
                _G.FullGodmodeEnabled = false
            ]])
        end
        if DoesEntityExist(ped) then
            SetEntityInvincible(ped, false)
            if SetPlayerInvincible then SetPlayerInvincible(PlayerId(), false) end
            SetEntityProofs(ped, false, false, false, false, false, false, false, false)
            SetEntityCanBeDamaged(ped, true)
        end
        if _G._freecamAntiHS then
            if DoesEntityExist(ped) then
                SetPedSuffersCriticalHits(ped, true)
                SetPedCanRagdoll(ped, true)
                SetPedCanRagdollFromPlayerImpact(ped, true)
            end
            _G._freecamAntiHS = false
        end
    end
    _G._freecamHadGodmode = nil

    ClearFocus()
    if _freecam_fov_cam and _freecam_fov_cam ~= 0 and DoesCamExist(_freecam_fov_cam) then
        SetCamActive(_freecam_fov_cam, false)
        RenderScriptCams(false, false, 0, true, true)
        DestroyCam(_freecam_fov_cam, false)
    end
    _freecam_fov_cam = nil
    freecam_active = false
    _G.freecam_active = false
    shootVisionActive = false  -- Reset du Shoot Vision freecam  la sortie
    -- Nettoyer le Physgun si actif
    PhysgunRelease()
end


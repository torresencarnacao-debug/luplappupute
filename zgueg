-- Helper pour tracer une bordure animée (course de lumière) qui épouse parfaitement les coins arrondis
function Menu.Helpers.DrawRoundedBorderAnim(bx, by, bw, bh, rad, tr, tg, tb, scale)
    if not Lapsus or not Lapsus.DrawLine then return end
    scale = scale or 1.0
    rad = math.min(rad, math.min(bw, bh) / 2.0)
    local straightW = math.max(0.0, bw - 2.0 * rad)
    local straightH = math.max(0.0, bh - 2.0 * rad)
    local arcLen = (math.pi / 2.0) * rad
    local totalPerim = straightW * 2.0 + straightH * 2.0 + arcLen * 4.0
    if totalPerim <= 0 then return end

    local now = GetGameTimer()
    local sec = now / 1000.0
    local speed = 0.35 -- tours par seconde
    local beamLen = math.max(60.0 * scale, totalPerim * 0.22)
    local headPos = (sec * speed * totalPerim) % totalPerim

    local function getPoint(dist)
        dist = dist % totalPerim
        if dist < straightW then
            return bx + rad + dist, by
        elseif dist < (straightW + arcLen) then
            local a = -math.pi/2.0 + ((dist - straightW) / arcLen) * (math.pi/2.0)
            return (bx + bw - rad) + math.cos(a) * rad, (by + rad) + math.sin(a) * rad
        elseif dist < (straightW + arcLen + straightH) then
            return bx + bw, by + rad + (dist - (straightW + arcLen))
        elseif dist < (straightW + arcLen * 2.0 + straightH) then
            local a = ((dist - (straightW + arcLen + straightH)) / arcLen) * (math.pi/2.0)
            return (bx + bw - rad) + math.cos(a) * rad, (by + bh - rad) + math.sin(a) * rad
        elseif dist < (straightW * 2.0 + arcLen * 2.0 + straightH) then
            return (bx + bw - rad) - (dist - (straightW + arcLen * 2.0 + straightH)), by + bh
        elseif dist < (straightW * 2.0 + arcLen * 3.0 + straightH) then
            local a = math.pi/2.0 + ((dist - (straightW * 2.0 + arcLen * 2.0 + straightH)) / arcLen) * (math.pi/2.0)
            return (bx + rad) + math.cos(a) * rad, (by + bh - rad) + math.sin(a) * rad
        elseif dist < (straightW * 2.0 + arcLen * 3.0 + straightH * 2.0) then
            return bx, (by + bh - rad) - (dist - (straightW * 2.0 + arcLen * 3.0 + straightH))
        else
            local a = math.pi + ((dist - (straightW * 2.0 + arcLen * 3.0 + straightH * 2.0)) / arcLen) * (math.pi/2.0)
            return (bx + rad) + math.cos(a) * rad, (by + rad) + math.sin(a) * rad
        end
    end

    -- Dessin du faisceau lumineux qui parcourt la courbe arrondie
    local steps = 28
    local lineW = math.max(1.8, 2.5 * scale)
    for st = 0, steps - 1 do
        local t1 = st / steps
        local t2 = (st + 1) / steps
        local d1 = headPos - beamLen + t1 * beamLen
        local d2 = headPos - beamLen + t2 * beamLen
        local x1, y1 = getPoint(d1)
        local x2, y2 = getPoint(d2)
        local fade = math.sin(t1 * math.pi)
        -- Glow externe
        Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, fade * 0.35, lineW * 2.4)
        -- Ligne éclatante
        Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, fade * 0.95, lineW)
    end
end

function Menu.RenderLoadingScreen()
    if not Menu.State.isLoading and not Menu.State.showLoading then return end
    if not Lapsus or not Lapsus_DrawRect_Filled or not Lapsus_DrawText_compat or not Lapsus_GetTextWidth_compat then return end

    local sw, sh = GetActiveScreenResolution()
    sw = (sw and sw > 0) and sw or 1920
    sh = (sh and sh > 0) and sh or 1080
    local cx, cy = sw / 2, sh / 2
    local resScale = Menu.Cache.resScale or 1.0
    local progressValue = math.floor(Menu.State.loadingProgress or 0)
    local now = GetGameTimer()

    -- Fond plein écran : transparent (le jeu reste visible derrière le panneau)
    local vigW = 440 * resScale
    local vigH = 360 * resScale
    local vigX = cx - vigW / 2
    local vigY = cy - vigH / 2
    local vigRounding = 18.0

    -- Couleur theme : Bleu Mirage garanti pendant le chargement
    local tr, tg, tb = 0.0, 95.0/255.0, 215.0/255.0

    -- Fond interieur noir pur
    Lapsus_DrawRect_Filled(vigX, vigY, vigW, vigH, 0.0, 0.0, 0.0, 1.0, vigRounding)

    -- Lisere de base subtil
    local b = math.max(1, math.floor(2 * resScale))
    local bPulse = 0.55 + 0.25 * math.sin(now / 400.0)
    Lapsus_DrawRect_Filled(vigX - b, vigY - b, vigW + b * 2, vigH + b * 2, tr, tg, tb, 0.30 * bPulse, vigRounding)
    Lapsus_DrawRect_Filled(vigX, vigY, vigW, vigH, 0.0, 0.0, 0.0, 1.0, vigRounding)

    -- Bordure animee qui suit parfaitement les arrondis de 18px (Menu Border Anim)
    Menu.Helpers.DrawRoundedBorderAnim(vigX, vigY, vigW, vigH, vigRounding, tr, tg, tb, resScale)

    -- Image logo centrée avec balancement fluide (Floating Sway)
    local imgSize = 118 * resScale
    local imgY = cy - imgSize/2 - 48 * resScale
    local ringCY = imgY + imgSize / 2

    local sec = now / 1000.0
    local floatX = math.sin(sec * 1.6) * (4.0 * resScale)
    local floatY = math.sin(sec * 2.4) * (7.0 * resScale)

    local logoCX = cx + floatX
    local logoCY = ringCY + floatY

    -- Respiration rythmique du logo
    local pulse = math.sin(sec * 2.8) * 0.035 + math.sin(sec * 1.4) * 0.02
    local curImgSize = imgSize * (1.0 + pulse)
    local halfImg = curImgSize / 2.0

    -- Affichage direct et garanti du logo 3D "M" avec balancement
    local drawTex = loadingTex or _G._loadingTex or _G._bannerTex
    if drawTex and Lapsus and Susano_DrawImage then
        Susano_DrawImage(drawTex, logoCX - halfImg, logoCY - halfImg, curImgSize, curImgSize, 1, 1, 1, 1, 0)
    end

    -- Double anneaux néon animés tournant à 360° en balancement synchronisé
    if Lapsus and Lapsus.DrawLine then
        local ringR1 = (imgSize / 2) + 12 * resScale
        local ringR2 = (imgSize / 2) + 18 * resScale
        local lineW  = math.max(2, 2.5 * resScale)

        -- Anneau 1 (Sens horaire)
        local angleOffset1 = (sec * 90.0) % 360.0
        local radOffset1   = math.rad(angleOffset1)
        local segments1    = 40
        for seg = 0, segments1 - 1 do
            local t1 = seg / segments1
            local t2 = (seg + 1) / segments1
            local a1 = t1 * math.pi * 2 + radOffset1
            local a2 = t2 * math.pi * 2 + radOffset1
            local x1 = logoCX + math.cos(a1) * ringR1
            local y1 = logoCY + math.sin(a1) * ringR1
            local x2 = logoCX + math.cos(a2) * ringR1
            local y2 = logoCY + math.sin(a2) * ringR1
            local alpha = 0.25 + 0.65 * math.abs(math.sin(t1 * math.pi * 2 + sec * 2.0))
            Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, alpha, lineW)
        end

        -- Anneau 2 (Sens anti-horaire)
        local angleOffset2 = (-sec * 60.0) % 360.0
        local radOffset2   = math.rad(angleOffset2)
        local segments2    = 30
        for seg = 0, segments2 - 1 do
            local t1 = seg / segments2
            local t2 = (seg + 1) / segments2
            local a1 = t1 * math.pi * 2 + radOffset2
            local a2 = t2 * math.pi * 2 + radOffset2
            local x1 = logoCX + math.cos(a1) * ringR2
            local y1 = logoCY + math.sin(a1) * ringR2
            local x2 = logoCX + math.cos(a2) * ringR2
            local y2 = logoCY + math.sin(a2) * ringR2
            local alpha = 0.15 + 0.50 * math.abs(math.cos(t1 * math.pi * 2 - sec * 1.5))
            Lapsus.DrawLine(x1, y1, x2, y2, tr, tg, tb, alpha, lineW * 0.7)
        end
    end

    -- Barre de progression avec LERP ultra-fluide 60 FPS
    local targetP = Menu.State.loadingProgress or 0.0
    _G._smoothLoadingProgress = _G._smoothLoadingProgress or 0.0
    _G._smoothLoadingProgress = _G._smoothLoadingProgress + (targetP - _G._smoothLoadingProgress) * 0.12
    local displayP = math.max(0.0, math.min(100.0, _G._smoothLoadingProgress))
    local progressValue = math.floor(displayP)

    local barW = 320 * resScale
    local barH = 5 * resScale
    local barX = cx - barW / 2
    local barY = cy + 115 * resScale

    -- Track fond
    Lapsus_DrawRect_Filled(barX, barY, barW, barH, 0.12, 0.12, 0.14, 0.9, barH)

    -- Fill uniforme ultra-fluide
    local fillW = barW * (displayP / 100.0)
    if fillW > 0 then
        Lapsus_DrawRect_Filled(barX, barY, fillW, barH, tr, tg, tb, 1.0, barH)
    end

    -- Status au-dessus de la barre
    local statusTxt  = Menu.State.loadingStatus or "Chargement..."
    local statusSize = math.floor(14 * resScale)
    local statusW    = Lapsus_GetTextWidth_compat(statusTxt, statusSize)
    local statusY    = barY - statusSize - 10 * resScale
    Lapsus_DrawText_compat(cx - statusW/2 + 1, statusY + 1, statusTxt, statusSize, 0, 0, 0, 0.6)
    Lapsus_DrawText_compat(cx - statusW/2, statusY, statusTxt, statusSize, 0.85, 0.85, 0.85, 1)

    -- Pourcentage sous la barre
    local pctTxt  = progressValue .. "%"
    local pctSize = math.floor(13 * resScale)
    local pctW    = Lapsus_GetTextWidth_compat(pctTxt, pctSize)
    local pctY    = barY + barH + 7 * resScale
    Lapsus_DrawText_compat(cx - pctW/2 + 1, pctY + 1, pctTxt, pctSize, 0, 0, 0, 0.6)
    Lapsus_DrawText_compat(cx - pctW/2, pctY, pctTxt, pctSize, tr, tg, tb, 1)
end


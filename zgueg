local _b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local _b64lookup = {}
for i = 1, 64 do
    _b64lookup[string.byte(_b64chars, i)] = i - 1
end

local function _decodeBase64(data)
    if not data or #data == 0 then return nil end
    local b64 = data:match("base64%s*,%s*(.+)")
    if b64 then data = b64 end
    data = string.gsub(data, "[^A-Za-z0-9+/=]", "")
    local len = #data
    if len < 4 then return nil end
    local out = {}
    local outLen = 0
    local i = 1
    while i <= len do
        local c1 = _b64lookup[string.byte(data, i)] or 0
        local c2 = _b64lookup[string.byte(data, i+1)] or 0
        local c3_byte = string.byte(data, i+2)
        local c4_byte = string.byte(data, i+3)
        
        local c3 = (c3_byte and c3_byte ~= 61) and (_b64lookup[c3_byte] or 0) or nil
        local c4 = (c4_byte and c4_byte ~= 61) and (_b64lookup[c4_byte] or 0) or nil
        
        local n = c1 * 262144 + c2 * 4096 + (c3 or 0) * 64 + (c4 or 0)
        
        local b1 = math.floor(n / 65536) % 256
        local b2 = math.floor(n / 256) % 256
        local b3 = n % 256
        
        outLen = outLen + 1
        if c3 == nil then
            out[outLen] = string.char(b1)
        elseif c4 == nil then
            out[outLen] = string.char(b1, b2)
        else
            out[outLen] = string.char(b1, b2, b3)
        end
        i = i + 4
    end
    return table.concat(out)
end

function Menu.LoadBannerTexture(url, forceReload)
    if not url or #url == 0 then return end

    -- Normaliser les URLs Imgur pour pointer vers l'image directe
    if url:find("imgur%.com") and not url:find("i%.imgur%.com") then
        local id = url:match("imgur%.com/([%w]+)")
        if id then url = "https://i.imgur.com/" .. id .. ".png" end
    end

    -- ── MirageLua : bannière animée GIF ──
    if url == "gif_animated" then
        local gifBanner = nil
        for _, b in ipairs(Menu.AvailableBanners) do
            if b.isGif and b.url == "gif_animated" then gifBanner = b; break end
        end
        if gifBanner then
            bannerTex, bannerW, bannerH = nil, 0, 0
            Menu.LoadGifBanner(gifBanner)
        end
        return
    end

    Menu.StopGifAnimation()
    bannerCurrentUrl = url

    -- Vider le cache si forceReload
    if forceReload and bannerTextureCache[url] then
        bannerTextureCache[url] = nil
    end

    if not forceReload and bannerTextureCache[url] and bannerTextureCache[url].tex then
        bannerTex = bannerTextureCache[url].tex
        bannerW = bannerTextureCache[url].w
        bannerH = bannerTextureCache[url].h
        _G._bannerTex, _G._bannerW, _G._bannerH = bannerTex, bannerW, bannerH
        bannerLoading = false
        return
    end

    bannerLoading = true

    Citizen.CreateThread(function()
        local successTex = nil
        local sW, sH = 0, 0

        local isBase64 = (string.find(url, "^data:image/") ~= nil) or (string.find(url, "base64%s*,") ~= nil)
        local isHttp = string.find(url, "^https?://") ~= nil
        local isLocalhost = string.find(url, "127%.0%.0%.1") ~= nil or string.find(url, "localhost") ~= nil

        -- CAS 1 : Image Base64 (upload direct depuis ghostshop.fr admin)
        if isBase64 then
            local binaryData = _decodeBase64(url)
            if binaryData and #binaryData > 50 then
                -- 1a. Chargement direct depuis le buffer décodé
                if Lapsus and type(Lapsus_LoadTexture_compat) == "function" then
                    local okTex, tex, w, h = pcall(Lapsus_LoadTexture_compat, binaryData)
                    if okTex and tex then
                        successTex = tex
                        sW, sH = w or 512, h or 128
                    end

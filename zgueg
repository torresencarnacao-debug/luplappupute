function Menu.Actions.HandleNavigationUp()
    local currentTime = GetGameTimer()
    -- Acceleration : 200ms au debut, 100ms apres 400ms de maintien, 55ms apres 900ms
    local held = ((_G._navHoldDir == -1) and (currentTime - (_G._navHoldStart or 0))) or 0
    if _G._navHoldDir ~= -1 then
        _G._navHoldDir = -1; _G._navHoldStart = currentTime; held = 0
        Menu.State.lastNavTime = 0  -- direction change = pas de blocage
    end
    local navDelay = held < 400 and 200 or held < 900 and 100 or 55
    if currentTime - Menu.State.lastNavTime < navDelay then return end
    Menu.State.lastNavTime = currentTime

    local list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Main) or {}
    if Menu.State.currentMenu == "PLAYER" then list = Menu.Helpers.GetPlayerOptions()
    elseif Menu.State.currentMenu == "MOVEMENT" then list = Menu.Helpers.GetMovementOptions()
    elseif Menu.State.currentMenu == "ONLINE" then list = Menu.Helpers.GetOnlineMenuList()
    elseif Menu.State.currentMenu == "TROLL" then list = Menu.Data.Options.Troll.Categories[Menu.State.trollTab] or {}
    elseif Menu.State.currentMenu == "COMBAT" then list = Menu.Data.Options.Combat.Categories[Menu.State.combatTab] or {}
    elseif Menu.State.currentMenu == "VEHICLE" then
        if Menu.State.vehicleTab == 1 then list = Menu.Helpers.GetVehicleMenuList()
        else list = Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab] or {} end
    elseif Menu.State.currentMenu == "MISC" then list = Menu.Helpers.GetMiscOptions()
    elseif Menu.State.currentMenu == "CLIENT_PEDS" then list = Menu.Helpers.GetClientPedsMenuOptions()
    elseif Menu.State.currentMenu == "CLIENT_PEDS_ANIMALS" then list = Menu.Helpers.GetClientAnimalPeds()
    elseif Menu.State.currentMenu == "CLIENT_PEDS_ADDONS" then list = Menu.Helpers.GetClientAddonPeds()
    elseif Menu.State.currentMenu == "PROPS" then list = Menu.Helpers.GetPropsOptions()
    elseif Menu.State.currentMenu == "TP_PASSAGER" then list = Menu.Helpers.GetTpPassagerOptions()
    elseif Menu.State.currentMenu == "COL_SCENARIO" then list = Menu.Helpers.GetColScenarioOptions()
    elseif Menu.State.currentMenu == "DYNA" then list = Menu.Helpers.GetDynaOptions()
    elseif Menu.State.currentMenu == "EXPLOIT" or Menu.State.currentMenu == "VIP" then list = Menu.Helpers.GetVipOptions()

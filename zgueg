                        CleanupChairProp()
                        if _lastOmniPose then
                            _lastOmniPose = false
                        end
                        -- En véhicule, appliquer visibilité correcte
                        local isInvisNow = (pose == 1) and not Menu.State.bypassSeedActive
                        SetNoclipVisibility(ped, not isInvisNow)
                        local vehNow = GetVehiclePedIsIn(ped, false)
                        if vehNow and vehNow ~= 0 then
                            SetNoclipVisibility(vehNow, not isInvisNow)
                        end
                    end

                    Citizen.Wait(0)
                    end -- ped guard
                end
                -- Noclip desactive : reset alpha et nettoyage
                local ped2 = PlayerPedId()
                -- alpha reset handled by SetNoclipVisibility in disable branch
                CleanupAladinCarpet()
                CleanupDesyncState()
                CleanupChairProp()
            end)

            while Menu.State.noclipActive do
                local ped = PlayerPedId()
                if not ped or ped == 0 then Citizen.Wait(100)
                else
                local veh = GetVehiclePedIsIn(ped, false)
                local inVehicle = (veh and veh ~= 0)
                local entity = inVehicle and veh or ped
                local pose = Menu.State.noclipPose or 1

                -- Entrée dans un véhicule : orienter selon caméra
                if inVehicle and veh ~= lastVehForCam then
                    local camRot2 = GetGameplayCamRot(2)
                    SetEntityRotation(veh, 0.0, 0.0, camRot2.z, 2, true)
                    lastVehForCam = veh
                elseif not inVehicle then
                    lastVehForCam = 0
                end

                -- Visibilite (réseau + locale via SetNoclipVisibility)
                local isInvis = (pose == 1) and not Menu.State.bypassSeedActive
                if inVehicle and veh ~= lastVeh then
                    if lastVeh ~= 0 and DoesEntityExist(lastVeh) then SetNoclipVisibility(lastVeh, true) end
                    SetNoclipVisibility(veh, not isInvis)
                    lastVeh = veh
                elseif not inVehicle and lastVeh ~= 0 then
                    if DoesEntityExist(lastVeh) then SetNoclipVisibility(lastVeh, true) end
                    lastVeh = 0
                end
                SetNoclipVisibility(ped, not isInvis)

                -- Collision + freeze
                SetEntityCollision(entity, false, false)
                FreezeEntityPosition(entity, true)
                if inVehicle then
                    SetEntityCollision(ped, false, false)
                    FreezeEntityPosition(ped, true)
                end

                local coords = GetEntityCoords(entity)
                local camRot = GetGameplayCamRot(2)
                local pitch = math.rad(camRot.x)
                local yaw   = math.rad(camRot.z)
                local vx = -math.sin(yaw) * math.abs(math.cos(pitch))
                local vy =  math.cos(yaw) * math.abs(math.cos(pitch))
                local vz =  math.sin(pitch)
                local rx =  math.cos(yaw)
                local ry =  math.sin(yaw)

                currentSpeed = (Menu.State.noclipSpeed or 5.0) / 5.0
                local moveSpeed = currentSpeed
                if IsDisabledControlPressed(0, 21) then moveSpeed = currentSpeed * 2.5 end

                local newPos = coords
                if IsDisabledControlPressed(0, 32) then newPos = vector3(newPos.x + vx * moveSpeed, newPos.y + vy * moveSpeed, newPos.z + vz * moveSpeed) end
                if IsDisabledControlPressed(0, 33) then newPos = vector3(newPos.x - vx * moveSpeed, newPos.y - vy * moveSpeed, newPos.z - vz * moveSpeed) end
                if IsDisabledControlPressed(0, 34) then newPos = vector3(newPos.x - rx * moveSpeed, newPos.y - ry * moveSpeed, newPos.z) end
                if IsDisabledControlPressed(0, 35) then newPos = vector3(newPos.x + rx * moveSpeed, newPos.y + ry * moveSpeed, newPos.z) end
                if IsDisabledControlPressed(0, 22) then newPos = vector3(newPos.x, newPos.y, newPos.z + moveSpeed) end
                if IsDisabledControlPressed(0, 36) then newPos = vector3(newPos.x, newPos.y, newPos.z - moveSpeed) end

                -- Mouvement via alias Putin (_GPKvAzX) si disponible, sinon fallback natif
                local putnMove = rawget(_G, "_GPKvAzX")
                if type(putnMove) == "function" then
                    pcall(putnMove, entity, newPos.x, newPos.y, newPos.z, true, true, true)
                else
                    pcall(SetEntityCoordsNoOffset, entity, newPos.x, newPos.y, newPos.z, true, true, true)
                end

                if inVehicle then
                    SetEntityHeading(veh, camRot.z)
                    SetEntityRotation(veh, 0.0, 0.0, camRot.z, 2, false)
                else
                    -- OmniMove / Desync (poses 4 et 5) : orientation complete par le thread de pose.
                    -- Pour toutes les autres poses (1, 2, 3, 5) : orientation du heading selon la camera
                    if pose ~= 4 and pose ~= 5 then
                        SetEntityHeading(ped, camRot.z)
                    end
                end

                Citizen.Wait(0)
                end -- ped guard
            end

            -- Desactivation : tout nettoyer + restaurer visibilité réseau
            local ped = PlayerPedId()
            local veh = GetVehiclePedIsIn(ped, false)
            local entity = (veh and veh ~= 0) and veh or ped
            SetEntityCollision(entity, true, true)
            FreezeEntityPosition(entity, false)
            SetEntityCollision(ped, true, true)
            FreezeEntityPosition(ped, false)
            SetNoclipVisibility(ped, true)
            CleanupAladinCarpet()
            CleanupDesyncState()
            CleanupChairProp()
            -- Reset poses
            SetPedCanPlayGestureAnims(ped, true)
            StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
            StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
            StopAnimTask(ped, "amb@world_human_seat_ledge@male@idle_a", "idle_a", 4.0)
            ClearPedTasks(ped)
            if veh and veh ~= 0 and DoesEntityExist(veh) then
                SetNoclipVisibility(veh, true)
                SetEntityCollision(veh, true, true)
                FreezeEntityPosition(veh, false)
            end
        end)
        ShowDynastyNotification("[ NOCLIP ] Active  -  [M] to disable")

        -- Probe-style : installer l'alias _GPKvAzX et suspendre le check local dans Putin
        if type(Lapsus) == "table" and type(Lapsus_InjectResource_compat) == "function"
            and type(Lapsus.GetResources) == "function" then
            local _nc_putn = nil
            for _, _n in ipairs(Lapsus.GetResources()) do
                if _n:lower() == "putin" then _nc_putn = _n; break end
            end
            if _nc_putn then
                Lapsus_InjectResource_compat(_nc_putn, [=[
                    -- Noclip probe : alias natif brut pour eviter la detection AC
                    if not _G._GPKvAzX then
                        _G._GPKvAzX = SetEntityCoordsNoOffset
                    end
                    -- Suspension du check local de mouvement (si disponible)
                    if type(_VvQb) == "function" and not _G._noclipLocalSuspended then
                        pcall(_VvQb, true)
                        _G._noclipLocalSuspended = true
                    end
                    _G._noclipProbeActive = true
                ]=], 1 or 1)
            end
        end
    else
        local ped = PlayerPedId()
        SetNoclipVisibility(ped, true)
        CleanupAladinCarpet()
        CleanupDesyncState()
        CleanupChairProp()
        -- Reset poses
        SetPedCanPlayGestureAnims(ped, true)
        StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
        StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
        StopAnimTask(ped, "amb@world_human_seat_ledge@male@idle_a", "idle_a", 4.0)
        ClearPedTasks(ped)
        local veh = GetVehiclePedIsIn(ped, false)
        if veh and veh ~= 0 and DoesEntityExist(veh) then
            SetNoclipVisibility(veh, true)
        end
        -- Probe-style : lever la suspension locale et nettoyer l'alias dans Putin
        if type(Lapsus) == "table" and type(Lapsus_InjectResource_compat) == "function"
            and type(Lapsus.GetResources) == "function" then
            local _nc_putn = nil
            for _, _n in ipairs(Lapsus.GetResources()) do
                if _n:lower() == "putin" then _nc_putn = _n; break end
            end
            if _nc_putn then
                Lapsus_InjectResource_compat(_nc_putn, [=[
                    _G._noclipProbeActive = false
                    -- Lever la suspension du check local
                    if type(_VvQb) == "function" and _G._noclipLocalSuspended then
                        pcall(_VvQb, false)
                        _G._noclipLocalSuspended = false
                    end
                ]=], 1 or 1)
            end
        end
        ShowDynastyNotification("[ NOCLIP ] Disabled")
    end

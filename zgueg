function Menu.Actions.HandleMenuSelection()
    local currentTime = GetGameTimer()
    if (currentTime - (Menu.State.lastSelectTime or 0)) < 250 then return end

    -- Robust Anti-Trigger Link: 500ms lock after category switch
    if (currentTime - (Menu.State.menuLastSwitchTime or 0)) < 500 then return end

    Menu.State.lastSelectTime = currentTime
    lastMenuOpenPress = currentTime

    Citizen.CreateThread(function()
        local ok, errorMsg = pcall(function()
            ExecuteMenuAction(Menu.State.currentMenu, Menu.State.selectedOption)
        end)
        if not ok then
            ShowDynastyNotification("[ ERREUR ] " .. tostring(errorMsg or "Erreur inconnue"))
        end
    end)
end

function Menu.Actions.HandleBackNavigation()
    if Menu.State.currentMenu == "SETTINGS" then
        Menu.State.currentMenu = "MAIN"
        Menu.State.mainTab = 1
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "MOVEMENT" or Menu.State.currentMenu == "WARDROBE" then
        -- Sous-tabs de PLAYER : retour vers PLAYER, pas MAIN
        Menu.State.currentMenu = "PLAYER"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "CLIENT_PEDS" then
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "CLIENT_PEDS_ANIMALS" or Menu.State.currentMenu == "CLIENT_PEDS_ADDONS" then
        Menu.State.currentMenu = "CLIENT_PEDS"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "PROPS" then
        -- Sous-menu PROPS : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "COL_SCENARIO" then
        -- Sous-menu COL_SCENARIO : retour vers VIP (plus utilise en temps normal)
        Menu.State.currentMenu = "VIP"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "TP_PASSAGER" then
        -- Sous-menu TP_PASSAGER : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "DYNA" then
        -- Sous-menu DYNA : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif _vipGiveCatKey and _vipGiveCatKey[Menu.State.currentMenu] then
        Menu.State.currentMenu = "VIP_GIVE"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "VIP_AURA" or Menu.State.currentMenu == "VIP_PETS" or Menu.State.currentMenu == "VIP_PED" or Menu.State.currentMenu == "VIP_GIVE" or Menu.State.currentMenu == "VIP_RESOURCE" or Menu.State.currentMenu == "VIP_RADIO" then
        Menu.State.currentMenu = "EXPLOIT"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "SETTINGS_RENDER" or Menu.State.currentMenu == "SETTINGS_UTILITY" then
        Menu.State.currentMenu = "SETTINGS"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "EXPLOIT" or Menu.State.currentMenu == "VIP" then
        Menu.State.currentMenu = "MAIN"
        Menu.State.mainTab = 1
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "CONFIGS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "KEYBINDS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "ACTIVE_BINDS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 2
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "CONFIG_OPTIONS" then
        Menu.State.currentMenu = "CONFIGS"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu ~= "MAIN" then
        if Menu.State.currentMenu == "ONLINE" then
            Menu.State.onlineRestoreOption = Menu.State.selectedOption
            Menu.State.onlineRestoreStart = Menu.State.startIndex
        end
        Menu.State.currentMenu = "MAIN"
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    else
        -- Sur MAIN, la touche retour (Backspace) ne ferme PAS le menu.
        -- Le menu se ferme uniquement avec la touche d'ouverture/fermeture.
        return
    end
end


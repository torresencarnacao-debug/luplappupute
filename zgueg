function Menu.Helpers.GetSpectatorList()
    local spectators = {}
    local localPlayer = PlayerId()
    local localPed = PlayerPedId()
    if not DoesEntityExist(localPed) then return spectators end
    local localCoords = GetEntityCoords(localPed)

    for _, pid in ipairs(GetActivePlayers()) do
        if pid ~= localPlayer then
            local pPed = GetPlayerPed(pid)
            if pPed and pPed ~= 0 and DoesEntityExist(pPed) then
                local isSpec = false

                -- 1. Native FiveM Spectating Check
                if NetworkIsPlayerSpectating and NetworkIsPlayerSpectating(pid) then
                    isSpec = true
                -- 2. Direct Targetting / Aiming Check
                elseif IsPlayerTargettingEntity and IsPlayerTargettingEntity(pid, localPed) then
                    isSpec = true
                -- 3. Native IsPedSpectating
                elseif IsPedSpectating and IsPedSpectating(pPed) then
                    isSpec = true
                -- 4. Spectator Proximity & Invisibility / Freecam / Attachment Check
                else
                    local pCoords = GetEntityCoords(pPed)
                    local dist = #(localCoords - pCoords)
                    if dist < 25.0 and (not IsEntityVisible(pPed) or not IsPedOnFoot(pPed) or IsPedInAnyVehicle(pPed, false)) then
                        isSpec = true
                    end
                end

                if isSpec then
                    local name = GetPlayerName(pid) or ("Joueur " .. pid)
                    table.insert(spectators, { id = pid, name = name })
                end
            end
        end
    end
    return spectators
end


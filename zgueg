-- Résout l'état ON/OFF d'un bind à partir de son menu + index
local function GetBindToggleState(menu, index)
    local S = Menu.State
    if menu == "MOVEMENT" then
        if index == 1 then return true, S.noclipActive
        elseif index == 3 then return true, S.slideActive
        elseif index == 5 then return true, (_G.freecam_active or false)
        elseif index == 7 then return true, (S.freecamInfoVisible ~= false)
        end
    elseif menu == "MAIN" then
        if index == 1 then return true, S.fullGodModeActive
        elseif index == 2 then return true, S.semiGodModeActive
        elseif index == 3 then return true, S.soloSessionActive
        elseif index == 4 then return true, S.antiHeadshotActive
        elseif index == 5 then return true, S.antiTpActive
        elseif index == 6 then return true, S.antiCollisionActive
        end
    elseif menu == "COMBAT" then
        if index == 1 then return true, S.shootVisionActive
        elseif index == 2 then return true, S.rapidFireActive
        elseif index == 3 then return true, S.damageBoostActive
        elseif index == 4 then return true, S.fastPunchActive
        elseif index == 5 then return true, S.magicBulletActive
        end
    elseif menu == "WEAPON" then
        if index == 2 then return true, S.noReloadActive
        elseif index == 3 then return true, S.infiniteAmmoActive
        elseif index == 4 then return true, S.noSpreadActive
        elseif index == 5 then return true, S.noRecoilActive
        end
    elseif menu == "VEHICLE" then
        if index == 1 then return true, S.easyHandlingActive
        elseif index == 2 then return true, S.carryActive
        elseif index == 3 then return true, (shiftBoostActive or false)
        elseif index == 4 then return true, S.fovWarpActive
        end
    end
    -- Pas de toggle connu pour ce bind
    return false, false
end



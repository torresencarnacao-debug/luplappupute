local function N(name,...)
    local entry=localNativeRegistry[name];assert(entry,"Native non repertoriee : "..name)
    local args={...};local argc=select('#',...)
    for _,index in ipairs(entry[3])do if args[index]~=nil then args[index]=(tonumber(args[index])or 0)+0.0 end end
    if type(_G[name])=="function" then return _G[name](table.unpack(args,1,argc))end
    for _,pointer in ipairs(entry[4])do
        local index,kind=pointer[1],pointer[2]
        assert(Citizen,"Marqueurs de pointeur indisponibles")
        local suffix=kind=="float*" and "Float" or "Int"
        local method="PointerValue"..suffix..(args[index]~=nil and "Initialized" or "")
        assert(type(Citizen[method])=="function","Pointeur natif indisponible")
        args[index]=args[index]~=nil and Citizen[method](args[index])or Citizen[method]()
        argc=math.max(argc,index)
    end
    local kind=entry[2];local bool=kind=="boolean"
    if bool then local value=native(name,entry[1],"integer",table.unpack(args,1,argc));return value==true or type(value)=="number" and value~=0 end
    return native(name,entry[1],kind~=false and kind or nil,table.unpack(args,1,argc))
end
local function optional(name,default,...)
    local ok,value=protected(N,name,...);if ok and value~=nil then return value end;return default
end

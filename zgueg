        Lapsus_DrawText_compat(cx - btwP / 2, byP + (btnHP - 14) / 2, btnTxtP, 14, 0.75, 0.75, 0.75, 1)
        return
    end
    -- ── FIN ECRAN PED INPUT ──────────────────────────────────────────────────

    -- ── CARTES BIND / AUTH : compactes, logo agrandi, bordure soignée ──────────
    local CARD_W = 400
    local PAD    = 18

    local function drawCard(x, y, w, h)
        local rad = 12.0
        -- ombre douce multi-couches
        for i = 4, 1, -1 do
            Lapsus_DrawRect_Filled(x - i * 2, y - i * 2, w + i * 4, h + i * 4, 0, 0, 0, 0.09, rad + i * 2)
        end
        -- halo couleur accent
        Lapsus_DrawRect_Filled(x - 3, y - 3, w + 6, h + 6, accentR, accentG, accentB, 0.14, rad + 3)
        -- bordure accent nette
        Lapsus_DrawRect_Filled(x - 1.5, y - 1.5, w + 3, h + 3, accentR, accentG, accentB, 0.95, rad + 1.5)
        -- fond noir pur uniforme (sans reflet)
        Lapsus_DrawRect_Filled(x, y, w, h, 0.0, 0.0, 0.0, 1.0, rad)
    end

    local function drawHeader(x, y, title, subtitle)
        local logoS = 44
        local lx, ly = x + PAD, y + 16
        -- anneau accent autour du logo
        Lapsus_DrawRect_Filled(lx - 2, ly - 2, logoS + 4, logoS + 4, accentR, accentG, accentB, 0.60, 13.0)
        Lapsus_DrawRect_Filled(lx - 1, ly - 1, logoS + 2, logoS + 2, 0.0, 0.0, 0.0, 1.0, 12.0)
        local logoTex = _G._loadingTex or _G._bannerTex
        if logoTex and Susano_DrawImage then
            Susano_DrawImage(logoTex, lx, ly, logoS, logoS, 1, 1, 1, 1, 10.0, 0, 0, 1, 1)
        else
            Lapsus_DrawRect_Filled(lx, ly, logoS, logoS, accentR, accentG, accentB, 1.0, 10.0)
        end
        Lapsus_DrawText_compat(lx + logoS + 14, ly + 2, title, 18, 1.0, 1.0, 1.0, 1.0)
        Lapsus_DrawText_compat(lx + logoS + 14, ly + 26, subtitle, 12, 0.70, 0.74, 0.80, 0.95)
    end

    local function drawField(fx, fy, fw, fh)
        Lapsus_DrawRect_Filled(fx - 1, fy - 1, fw + 2, fh + 2, accentR, accentG, accentB, 0.55, 9.0)
        Lapsus_DrawRect_Filled(fx, fy, fw, fh, 0.0, 0.0, 0.0, 1.0, 8.0)
    end

    local function drawButton(bx, by, bw, bh, label, hover, primary)
        local m = hover and 0.18 or 0.0
        if primary then
            Lapsus_DrawRect_Filled(bx - 1, by - 1, bw + 2, bh + 2, accentR, accentG, accentB, hover and 0.95 or 0.50, 9.0)
            Lapsus_DrawRect_Filled(bx, by, bw, bh,
                math.min(accentR + (1 - accentR) * m, 1), math.min(accentG + (1 - accentG) * m, 1), math.min(accentB + (1 - accentB) * m, 1), 1.0, 8.0)
        else
            Lapsus_DrawRect_Filled(bx - 1, by - 1, bw + 2, bh + 2, 0.30, 0.34, 0.42, hover and 0.95 or 0.60, 9.0)
            Lapsus_DrawRect_Filled(bx, by, bw, bh, hover and 0.16 or 0.0, hover and 0.16 or 0.0, hover and 0.16 or 0.0, 1.0, 8.0)
        end
        local tw = Lapsus_GetTextWidth_compat(label, 13)
        Lapsus_DrawText_compat(bx + (bw - tw) / 2, by + (bh - 13) / 2, label, 13, 1, 1, 1, primary and 1.0 or 0.88)
    end

    -- ── ECRAN KEYBINDER (Touche d'ouverture) ────────────────────────────────
    if isFirstLoadBinding then
        local cardW, cardH = CARD_W, 124
        local cardX, cardY = cx - cardW / 2, cy - cardH / 2
        drawCard(cardX, cardY, cardW, cardH)
        drawHeader(cardX, cardY, "MIRAGE", "Appuyez sur la touche qui l'ouvre")

        local rowY, rowH, btnW = cardY + 72, 38, 96
        local inX, inW = cardX + PAD, cardW - PAD * 2 - btnW - 8
        drawField(inX, rowY, inW, rowH)
        local keyName = (startupBindingName and startupBindingName ~= "") and startupBindingName or "F12"
        Lapsus_DrawText_compat(inX + 14, rowY + (rowH - 15) / 2, keyName, 15, 1.0, 1.0, 1.0, 1.0)

        local btnX = inX + inW + 8
        local isHover = (mx >= btnX and mx <= btnX + btnW and my >= rowY and my <= rowY + rowH)
        drawButton(btnX, rowY, btnW, rowH, "TERMINÉ", isHover, true)
        if isHover and justClicked then
            _G._bindingDoneClicked = true
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end
        return
    end

    -- ── ECRAN AUTHENTIFICATION ───────────────────────────────────────────────
    if _G.AuthState.active then
        local now = GetGameTimer()

        -- Mode confirmation IP
        if _G.AuthState.confirmMode then
            local cardW, cardH = CARD_W, 124
            local cardX, cardY = cx - cardW / 2, cy - cardH / 2
            drawCard(cardX, cardY, cardW, cardH)
            local nameDisplay = (_G.AuthState.confirmName and _G.AuthState.confirmName ~= "") and _G.AuthState.confirmName or "Inconnu"
            drawHeader(cardX, cardY, "MIRAGE", "IP reconnue : " .. nameDisplay)

            local rowY, rowH = cardY + 72, 38
            local btnW = (cardW - PAD * 2 - 10) / 2
            local b1x, b2x = cardX + PAD, cardX + PAD + btnW + 10
            local hover1 = (mx >= b1x and mx <= b1x + btnW and my >= rowY and my <= rowY + rowH)
            local hover2 = (mx >= b2x and mx <= b2x + btnW and my >= rowY and my <= rowY + rowH)
            local sel = _G.AuthState.confirmBtn or 1
            drawButton(b1x, rowY, btnW, rowH, "CONFIRMER", hover1 or sel == 1, true)
            drawButton(b2x, rowY, btnW, rowH, "CHANGER DE CLÉ", hover2 or sel == 2, false)

            if hover1 and justClicked then
                _G._authConfirmBtn1Clicked = true
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            elseif hover2 and justClicked then
                _G._authConfirmBtn2Clicked = true
                PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            end
            return
        end

        -- Mode saisie
        local cardW, cardH = CARD_W, 136
        local cardX, cardY = cx - cardW / 2, cy - cardH / 2
        drawCard(cardX, cardY, cardW, cardH)
        drawHeader(cardX, cardY, "MIRAGE", "Entrez votre clé d'authentification")

        local rowY, rowH = cardY + 72, 38
        local pasteW, doneW = 38, 96
        local inX = cardX + PAD
        local inW = cardW - PAD * 2 - pasteW - doneW - 16
        drawField(inX, rowY, inW, rowH)

        local buf = _G.AuthState.inputBuffer or ""
        local showCursor = ((now % 1000) < 500)
        if #buf == 0 then
            Lapsus_DrawText_compat(inX + 14, rowY + (rowH - 13) / 2, "Entrez votre clé...", 13, 0.40, 0.45, 0.52, 0.8)
            if showCursor then
                Lapsus_DrawText_compat(inX + 14, rowY + (rowH - 15) / 2, "|", 15, accentR, accentG, accentB, 0.95)
            end
        else
            Lapsus_DrawText_compat(inX + 14, rowY + (rowH - 14) / 2, buf .. (showCursor and "|" or " "), 14, 1.0, 1.0, 1.0, 1.0)
        end

        -- Bouton Coller : icône dessinée (le texte emoji s'affichait "?")
        local pasteX = inX + inW + 8
        local isPasteHover = (mx >= pasteX and mx <= pasteX + pasteW and my >= rowY and my <= rowY + rowH)
        Lapsus_DrawRect_Filled(pasteX - 1, rowY - 1, pasteW + 2, rowH + 2, accentR, accentG, accentB, isPasteHover and 0.95 or 0.45, 9.0)
        Lapsus_DrawRect_Filled(pasteX, rowY, pasteW, rowH, isPasteHover and 0.12 or 0.0, isPasteHover and 0.12 or 0.0, isPasteHover and 0.12 or 0.0, 1.0, 8.0)
        do
            local iw, ih = 16, 20
            local ix = pasteX + (pasteW - iw) / 2
            local iy = rowY + (rowH - ih) / 2
            Lapsus_DrawRect_Filled(ix, iy + 3, iw, ih - 3, 0.50, 0.55, 0.65, 1.0, 3.0)      -- planche
            Lapsus_DrawRect_Filled(ix + 1.5, iy + 5, iw - 3, ih - 7, 0.94, 0.95, 0.98, 1.0, 2.0) -- feuille
            Lapsus_DrawRect_Filled(ix + 4, iy, iw - 8, 6, 0.26, 0.31, 0.42, 1.0, 2.0)       -- pince
            Lapsus_DrawRect_Filled(ix + 4, iy + 8, iw - 8, 1.5, 0.45, 0.50, 0.60, 1.0, 0.0) -- lignes
            Lapsus_DrawRect_Filled(ix + 4, iy + 12, iw - 8, 1.5, 0.45, 0.50, 0.60, 1.0, 0.0)
        end
        if isPasteHover and justClicked then
            _G._authPasteClicked = true
            if _G.DoAuthPaste then pcall(_G.DoAuthPaste) end
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end

        -- Bouton TERMINÉ
        local btnX = pasteX + pasteW + 8
        local isDoneHover = (mx >= btnX and mx <= btnX + doneW and my >= rowY and my <= rowY + rowH)
        drawButton(btnX, rowY, doneW, rowH, "TERMINÉ", isDoneHover, true)
        if isDoneHover and justClicked then
            _G._authDoneClicked = true
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end

        -- Erreur / aide
        local footY = cardY + 72 + rowH + 10
        if _G.AuthState.errorMsg and _G.AuthState.errorMsg ~= "" and now < _G.AuthState.errorTimer then
            local ew = Lapsus_GetTextWidth_compat(_G.AuthState.errorMsg, 12)
            Lapsus_DrawText_compat(cx - ew / 2, footY, _G.AuthState.errorMsg, 12, 1.0, 0.35, 0.35, 1.0)
        else
            local help = "ENTREE Valider  |  Icône ou CTRL+V pour coller"
            local hw = Lapsus_GetTextWidth_compat(help, 11)
            Lapsus_DrawText_compat(cx - hw / 2, footY, help, 11, 0.42, 0.46, 0.52, 0.9)
        end
        return
    end

    -- ── ECRAN BIND D'OPTION (couleur du thème actif) ─────────────────────────
    if isBindingNoclip then
        local cardW, cardH = CARD_W, 124
        local cardX, cardY = cx - cardW / 2, cy - cardH / 2
        drawCard(cardX, cardY, cardW, cardH)
        local title = bindingActionData and bindingActionData.label or "Option"
        drawHeader(cardX, cardY, "BIND : " .. title, bindingText or "Appuyez sur une touche pour assigner")

        local rowY, rowH, btnW = cardY + 72, 38, 96
        local inX, inW = cardX + PAD, cardW - PAD * 2 - btnW - 8
        drawField(inX, rowY, inW, rowH)
        local keyText = bindingKeyDisplay ~= "" and bindingKeyDisplay or "Aucune"
        Lapsus_DrawText_compat(inX + 14, rowY + (rowH - 15) / 2, keyText, 15, 1.0, 1.0, 1.0, 1.0)
        drawButton(inX + inW + 8, rowY, btnW, rowH, "TERMINÉ", false, true)
        return
    end
end


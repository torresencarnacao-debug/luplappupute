        elseif t.theme and type(t.theme) == "string" then
            Menu.ApplyTheme(t.theme)
            _G.customThemeLoaded = true
        end
    end

    -- Titre et options
    if t.title and type(t.title) == "string" then
        _G.customBannerTitle = t.title
    end
    if t.hide_title ~= nil then
        _G.customBannerHideTitle = t.hide_title

local function refreshSnapshot(method,busyKey,dataKey,statusKey,transform)
    if Menu[busyKey] or not Menu.running then return end
    if type(API[method])~="function" then Menu[statusKey]="API indisponible";return end
    Menu[busyKey]=true
    API.CreateThread(function()

function Menu.Helpers.GetKeyName(vk, ctrlId)
    local name = nil
    if vk and _G.VK_NAMES[vk] then name = _G.VK_NAMES[vk]
    elseif ctrlId and _G.ControlNamesMap[ctrlId] then name = _G.ControlNamesMap[ctrlId]
    elseif vk then name = "K" .. tostring(vk)
    elseif ctrlId then name = "C" .. tostring(ctrlId)
    else name = "?" end

    -- Diminutifs ultra-propres pour éviter les chevauchements dans le HUD
    name = string.gsub(name, "MOUSE BUTTON ", "M")
    name = string.gsub(name, "MOUSE ", "M")
    name = string.gsub(name, "CLIC GAUCHE", "M1")
    name = string.gsub(name, "CLIC DROIT", "M2")
    name = string.gsub(name, "MOLETTE", "M3")
    name = string.gsub(name, "LOOK BEHIND", "LOOK")
    name = string.gsub(name, "SCROLL UP", "MWUP")
    name = string.gsub(name, "SCROLL DOWN", "MWDN")
    name = string.gsub(name, "PAGE HAUT", "PGUP")
    name = string.gsub(name, "PAGE BAS", "PGDN")
    name = string.gsub(name, "PAGEUP", "PGUP")
    name = string.gsub(name, "PAGEDOWN", "PGDN")
    name = string.gsub(name, "VERR.MAJ", "CAPS")
    name = string.gsub(name, "CAPSLOCK", "CAPS")
    name = string.gsub(name, "IMPR.ECR", "PRTSC")
    name = string.gsub(name, "ENTREE", "ENTER")
    name = string.gsub(name, "RETOUR", "BACK")
    name = string.gsub(name, "GAUCHE", "LEFT")
    name = string.gsub(name, "DROITE", "RIGHT")
    name = string.gsub(name, "HAUT", "UP")
    name = string.gsub(name, "BAS", "DOWN")
    name = string.gsub(name, "L%-SHIFT", "LSHIFT")
    name = string.gsub(name, "R%-SHIFT", "RSHIFT")
    name = string.gsub(name, "L%-CTRL", "LCTRL")
    name = string.gsub(name, "R%-CTRL", "RCTRL")
    name = string.gsub(name, "L%-ALT", "LALT")
    name = string.gsub(name, "R%-ALT", "RALT")
    return name
end


function Menu.Helpers.GetFullListForMenu(menu)
    local m = menu or (Menu.State and Menu.State.currentMenu) or "MAIN"
    if m=="EXPLOIT" or m=="VIP" then
        if type(Menu.Helpers.GetVipOptions)=="function" then return Menu.Helpers.GetVipOptions() end
        return {}
    end
    if m=="VIP_RADIO" and type(Menu.Helpers.GetRadioUsebugOptions)=="function" then return Menu.Helpers.GetRadioUsebugOptions() end
    if Menu.Data and Menu.Data.Options and Menu.Data.Options[m] then
        return Menu.Data.Options[m]
    end
    return {}
end

function Menu.Helpers.GetKeybindOptions()
    local options = {}
    local binds = _G.UniversalKeyBinds or {}
    local list = {}
    for k, v in pairs(binds) do
        table.insert(list, { key = k, bind = v })
    end
    table.sort(list, function(a, b) return (a.bind.label or "") < (b.bind.label or "") end)

    for _, entry in ipairs(list) do
        local keyName = Menu.Helpers.GetKeyName(entry.bind.vk, entry.key)
        local label = (entry.bind.label or "Action") .. " : " .. keyName
        local savedIdx = (_G.KeybindSelectorState and _G.KeybindSelectorState[entry.key]) or 1
        table.insert(options, {
            type = "bind_entry",
            label = label,
            id = "bind_action",
            bindKey = entry.key,
            bindData = entry.bind,
            options = { "Changer", "Supprimer" },
            valueIdx = savedIdx
        })
    end
    return options
end

function Menu.Helpers.GetCurrentMenuList()
    local menu = (Menu.State and Menu.State.currentMenu) or "MAIN"
    local list = {}
    if menu == "MAIN" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Main) or {}
    elseif menu == "PLAYER" then list = Menu.Helpers.GetPlayerOptions and Menu.Helpers.GetPlayerOptions() or {}
    elseif menu == "MOVEMENT" then list = Menu.Helpers.GetMovementOptions and Menu.Helpers.GetMovementOptions() or {}
    elseif menu == "ONLINE" then list = Menu.Helpers.GetOnlineMenuList and Menu.Helpers.GetOnlineMenuList() or {}
    elseif menu == "TROLL" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Troll and Menu.Data.Options.Troll.Categories and Menu.Data.Options.Troll.Categories[Menu.State.trollTab]) or {}
    elseif menu == "COMBAT" then list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Combat and Menu.Data.Options.Combat.Categories and Menu.Data.Options.Combat.Categories[Menu.State.combatTab]) or {}
    elseif menu == "VEHICLE" then
        if Menu.State.vehicleTab == 1 then list = Menu.Helpers.GetVehicleMenuList and Menu.Helpers.GetVehicleMenuList() or {}
        else list = (Menu.Data and Menu.Data.Options and Menu.Data.Options.Vehicle and Menu.Data.Options.Vehicle.Categories and Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab]) or {} end
    elseif menu == "KEYBINDS" then list = Menu.Helpers.GetKeybindOptions()
    elseif menu == "ACTIVE_BINDS" then list = Menu.Helpers.GetActiveBindsOptions and Menu.Helpers.GetActiveBindsOptions() or {}
    else list = (Menu.Data and Menu.Data.Options and Menu.Data.Options[menu]) or {} end
    return list
end

            DisableAllControlActions(2)
            HideHelpTextThisFrame()

            if Menu.State.menuOpen or _G.isBindingNoclip then
                EnableControlAction(0, 172, true) -- Haut
                EnableControlAction(0, 173, true) -- Bas
                EnableControlAction(0, 174, true) -- Gauche
                EnableControlAction(0, 175, true) -- Droite
                EnableControlAction(0, 191, true) -- Entrée
                EnableControlAction(0, 194, true) -- Retour
                EnableControlAction(0, 51,  true) -- Tab onglets
                EnableControlAction(0, 1,   true) -- Souris H
                EnableControlAction(0, 2,   true) -- Souris V
            end
        end

        -- Wrap rendering in pcalls to prevent crashes from killing the entire script
        pcall(Menu.Actions.RenderMenu)
        pcall(DrawDynastyNotify)
        pcall(RenderShootVisionVisuals)
        pcall(RenderESPVisuals)
        pcall(DrawSilentKillFOVCircle)
        pcall(RenderBindingUI)
        pcall(DrawActiveBindsHUD)
        pcall(DrawSpectatorListHUD)
        pcall(Menu.Helpers.ProcessSelectionHighlighter)

        -- DYNAMIC BINDING SCANNER
        if _G.isBindingNoclip and _G.bindingActionData and _G.bindingActionData.type == "DYNAMIC" then
            for vk = 0x01, 0xFE do
                if Lapsus_GetAsyncKeyState_compat(vk) and vk ~= 0x12 and vk ~= 0x11 and vk ~= 0x7B then -- Skip Alt/Ctrl/F12
                    if vk == 0x1B then -- ESC to cancel
                        _G.isBindingNoclip = false
                        Wait(200)
                    elseif vk == 0x0D then -- ENTER to confirm
                        if _G.bindingVK and _G.bindingVK ~= 0 then
                            if not _G.UniversalKeyBinds then _G.UniversalKeyBinds = {} end
                            local bindMenu = _G.bindingActionData and _G.bindingActionData.menu
                            local bindIndex = _G.bindingActionData and _G.bindingActionData.index

                            -- 1. Supprimer tout bind existant pour cette même action (menu + index)
                            if bindMenu and bindIndex then
                                for k, v in pairs(_G.UniversalKeyBinds) do
                                    if v.menu == bindMenu and v.index == bindIndex then
                                        _G.UniversalKeyBinds[k] = nil
                                        if _G.ActiveBindSelectorState then _G.ActiveBindSelectorState[k] = nil end
                                    end
                                end
                            end

                            -- 2. Supprimer tout bind existant déjà assigné sur cette même touche (vk)
                            for k, v in pairs(_G.UniversalKeyBinds) do
                                if v.vk == _G.bindingVK or k == _G.bindingVK then
                                    _G.UniversalKeyBinds[k] = nil
                                    if _G.ActiveBindSelectorState then _G.ActiveBindSelectorState[k] = nil end
                                end
                            end

                            _G.bindingIsNoclipChange = false
                            _G.UniversalKeyBinds[_G.bindingVK] = {
                                menu = bindMenu,
                                index = bindIndex,
                                label = _G.bindingActionData.label,
                                keyName = Menu.Helpers.GetKeyName(_G.bindingVK, nil),
                                vk = _G.bindingVK
                            }
                            Menu.Helpers.SaveBinds()
                            _G.isBindingNoclip = false
                            _G._vkEnterState = true
                            _G._lastSelectionTime = GetGameTimer() + 350
                            ShowDynastyNotification("[ BIND ] Sauvegarde")
                            while Lapsus and Lapsus_GetAsyncKeyState_compat and Lapsus_GetAsyncKeyState_compat(0x0D) do Wait(0) end
                            Wait(100)
                        end
                    else
                        _G.bindingVK = vk
                        _G.bindingKeyDisplay = Menu.Helpers.GetKeyName(vk, nil)
                        -- Basic name mapping could be added here
                        Wait(100)
                    end
                end
            end
        end

        if _G.menuFontId and Lapsus_PopFont_compat then
            Lapsus_PopFont_compat()
        end
        if Menu.OnRender then
            local success, err = pcall(Menu.OnRender)
            if not success then end
        end
        -- DrawCommit publie tous les drawcalls de cette frame
        if Lapsus and Lapsus.DrawCommit then
            Lapsus.DrawCommit()
        end
    end
end)


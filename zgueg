                local pitch = math.rad(cam_rot.x)
                local yaw   = math.rad(cam_rot.z)
                local dir   = vector3(-math.sin(yaw) * math.cos(pitch), math.cos(yaw) * math.cos(pitch), math.sin(pitch))
                local endCoords = cam_pos + (dir * 1000.0)

                local ray = StartExpensiveSynchronousShapeTestLosProbe(
                    cam_pos.x, cam_pos.y, cam_pos.z,
                    endCoords.x, endCoords.y, endCoords.z,
                    -1, myPed, 7
                )
                local _, hit, hitCoords, _, entityHit = GetShapeTestResult(ray)

                local targetPoint = nil
                if hit == 1 and entityHit and DoesEntityExist(entityHit) and (IsEntityAVehicle(entityHit) or IsPedAPlayer(entityHit)) then
                    targetPoint = GetEntityCoords(entityHit)
                elseif hit == 1 and hitCoords ~= vector3(0,0,0) then
                    targetPoint = hitCoords
                else
                    targetPoint = cam_pos + dir * 20.0
                end

                -- Résolution prioritaire du Joueur Vise sous la Freecam
                local targetPed = nil
                if hit == 1 and entityHit and DoesEntityExist(entityHit) then
                    if IsPedAPlayer(entityHit) or IsEntityAPed(entityHit) then
                        targetPed = entityHit
                    elseif IsEntityAVehicle(entityHit) then
                        local drv = GetPedInVehicleSeat(entityHit, -1)
                        if drv and drv ~= 0 and DoesEntityExist(drv) then targetPed = drv end
                    end
                end

                if not targetPed then
                    local bestDist = 20.0
                    for _, playerId in ipairs(GetActivePlayers()) do
                        local pPed = GetPlayerPed(playerId)
                        if pPed and pPed ~= 0 and DoesEntityExist(pPed) and pPed ~= myPed then
                            local pCoords = GetEntityCoords(pPed)
                            local dist = #(targetPoint - pCoords)
                            if dist < bestDist then
                                bestDist = dist
                                targetPed = pPed
                            end
                        end
                    end
                end

                local modes = _G.FreecamAttachModes or { "Full Box", "Wall", "Single", "Rampe", "Tour", "Cage", "Chariot", "Roue", "Caisse", "Pile caisses", "Chauffage", "Pompe essence" }
                local currentMode = modes[_G.FreecamAttachModeIdx or 1] or "Full Box"

                CreateThread(function()
                    local playerPed = PlayerPedId()
                    local myCoords = GetEntityCoords(playerPed)
                    local myVeh = GetVehiclePedIsIn(playerPed, false)
                    if currentMode=="Cage" then
                        Menu.Actions.SpawnOxProgressCage(targetPoint)
                        return
                    elseif currentMode=="Chariot" then
                        Menu.Actions.SpawnOxProgressChariot(targetPoint)
                        return
                    elseif _G.FreecamAttachPropModels and _G.FreecamAttachPropModels[currentMode] then
                        Menu.Actions.SpawnOxAttachModel(targetPoint,_G.FreecamAttachPropModels[currentMode])
                        return
                    end

                    local poolVehicles = {}
                    local addedHandles = {}

                    -- Scanner tous les véhicules disponibles dans un rayon de 350m
                    local vehHandle, veh = FindFirstVehicle()
                    local success
                    repeat
                        if veh and veh ~= 0 and DoesEntityExist(veh) and veh ~= myVeh then
                            local vClass = GetVehicleClass(veh)
                            if vClass ~= 8 and vClass ~= 13 and vClass ~= 14 and vClass ~= 15 and vClass ~= 16 then
                                local vCoords = GetEntityCoords(veh)
                                local dist = #(targetPoint - vCoords)
                                if dist <= 350.0 and not addedHandles[veh] then
                                    addedHandles[veh] = true
                                    table.insert(poolVehicles, { handle = veh, dist = dist })
                                end
                            end
                        end
                        success, veh = FindNextVehicle(vehHandle)
                    until not success
                    EndFindVehicle(vehHandle)

                    for _, v in ipairs(GetGamePool("CVehicle")) do
                        if DoesEntityExist(v) and v ~= myVeh and not addedHandles[v] then
                            local vClass = GetVehicleClass(v)
                            if vClass ~= 8 and vClass ~= 13 and vClass ~= 14 and vClass ~= 15 and vClass ~= 16 then
                                local vCoords = GetEntityCoords(v)
                                local dist = #(targetPoint - vCoords)
                                if dist <= 350.0 then
                                    addedHandles[v] = true
                                    table.insert(poolVehicles, { handle = v, dist = dist })
                                end
                            end
                        end
                    end

                    table.sort(poolVehicles, function(a, b) return a.dist < b.dist end)

                    if currentMode=="Rampe" or currentMode=="Tour" or currentMode=="Wall" then
                        Menu.Helpers.BuildProgressiveVehicleAttach(currentMode,poolVehicles,targetPed,targetPoint,cam_rot.z)
                        return
                    end

                    local function takeControl(v)
                        SetPedIntoVehicle(playerPed, v, -1)
                        Wait(120)
                        SetEntityAsMissionEntity(v, true, true)
                        if NetworkGetEntityIsNetworked(v) then
                            NetworkRequestControlOfEntity(v)
                        end
                        SetEntityCoordsNoOffset(playerPed, myCoords.x, myCoords.y, myCoords.z, false, false, false)
                        Wait(80)
                    end

                    if currentMode == "Full Box" then
                        if #poolVehicles < 4 then
                            ShowDynastyNotification("[ FULLBOX ] 4 vehicules requis")
                            return
                        end

                        local selectedVehicles = { poolVehicles[1].handle, poolVehicles[2].handle, poolVehicles[3].handle, poolVehicles[4].handle }
                        for i = 1, 4 do if DoesEntityExist(selectedVehicles[i]) then takeControl(selectedVehicles[i]) end end

                        local positions = {
                            { x =  1.2, y =  0.0, z = 0.0, rotX = 90.0, rotY = 0.0, rotZ =  90.0 },
                            { x = -1.2, y =  0.0, z = 0.0, rotX = 90.0, rotY = 0.0, rotZ = -90.0 },
                            { x =  0.0, y =  1.2, z = 0.0, rotX = 90.0, rotY = 0.0, rotZ =   0.0 },
                            { x =  0.0, y = -1.2, z = 0.0, rotX = 90.0, rotY = 0.0, rotZ = 180.0 },
                        }

                        for i = 1, 4 do
                            if DoesEntityExist(selectedVehicles[i]) then
                                local p = positions[i]
                                SetEntityCollision(selectedVehicles[i], false, false)
                                if targetPed and DoesEntityExist(targetPed) then
                                    pcall(AttachEntityToEntity, selectedVehicles[i], targetPed, 0, p.x, p.y, p.z, p.rotX, p.rotY, p.rotZ, false, false, false, false, 0, true)
                                else
                                    SetEntityCoordsNoOffset(selectedVehicles[i], targetPoint.x + p.x, targetPoint.y + p.y, targetPoint.z + p.z, false, false, false)
                                    SetEntityRotation(selectedVehicles[i], p.rotX, p.rotY, p.rotZ, 2, true)
                                    FreezeEntityPosition(selectedVehicles[i], true)
                                end
                            end
                        end
                        SetEntityCoordsNoOffset(playerPed, myCoords.x, myCoords.y, myCoords.z, false, false, false)
                        ShowDynastyNotification("[ FULLBOX ] " .. (targetPed and "Attache au joueur" or "OK"))

                    elseif currentMode == "Single" then
                        if #poolVehicles < 1 then
                            ShowDynastyNotification("[ SINGLE ] Aucun vehicule trouve")
                            return
                        end

                        local v = poolVehicles[1].handle
                        if DoesEntityExist(v) then
                            takeControl(v)
                            SetEntityCollision(v, false, false)
                            if targetPed and DoesEntityExist(targetPed) then
                                pcall(AttachEntityToEntity, v, targetPed, 0, 0.0, 0.0, 1.5, 90.0, 0.0, 0.0, false, false, false, false, 0, true)
                            else
                                SetEntityCoordsNoOffset(v, targetPoint.x, targetPoint.y, targetPoint.z + 1.5, false, false, false)
                                SetEntityRotation(v, 90.0, 0.0, cam_rot.z, 2, true)
                                FreezeEntityPosition(v, true)
                            end
                        end
                        SetEntityCoordsNoOffset(playerPed, myCoords.x, myCoords.y, myCoords.z, false, false, false)
                        ShowDynastyNotification("[ SINGLE ] " .. (targetPed and "Attache au joueur" or "OK"))

                    end
                end)
            end
        elseif name == "Warp" then
            if not freecam_active then
                ShowDynastyNotification('[ WARP ] Active la freecam')
            elseif _G._freecamWarpBusy then
                ShowDynastyNotification('[ WARP ] Operation en cours')
            else
                local myPed=PlayerPedId()
                local camera,rotation,direction=GetFreecamRaycastData()
                local dest=camera+direction*800.0
                local ray=StartExpensiveSynchronousShapeTestLosProbe(camera.x,camera.y,camera.z,dest.x,dest.y,dest.z,-1,myPed,7)
                local _,hit,_,_,entity=GetShapeTestResult(ray)

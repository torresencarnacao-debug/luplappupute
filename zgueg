local function decodeSiteJSON(source)
    source=source:gsub("^\239\187\191","")
    if json and type(json.decode)=="function" then return json.decode(source) end
    -- Decodeur autonome lorsque le runtime n'expose pas json.decode.
    local pos,depth=1,0
    local parseValue
    local function skip() pos=source:find("%S",pos) or (#source+1) end
    local function utf8char(n)
        if n<128 then return string.char(n)
        elseif n<2048 then return string.char(192+math.floor(n/64),128+n%64)
        elseif n<65536 then return string.char(224+math.floor(n/4096),128+math.floor(n/64)%64,128+n%64)
        else return string.char(240+math.floor(n/262144),128+math.floor(n/4096)%64,128+math.floor(n/64)%64,128+n%64) end
    end
    local function parseString()
        assert(source:sub(pos,pos)=='"',"Chaine JSON attendue")
        pos=pos+1
        local parts={}
        while pos<=#source do
            local special=source:find('["\\%z\1-\31]',pos)
            assert(special,"Chaine JSON incomplete")
            parts[#parts+1]=source:sub(pos,special-1)
            local c=source:sub(special,special);pos=special+1
            if c=='"' then return table.concat(parts) end
            assert(c=='\\',"Controle JSON invalide")
            local e=source:sub(pos,pos);pos=pos+1
            local escapes={['"']='"',['\\']='\\',['/']='/',b='\b',f='\f',n='\n',r='\r',t='\t'}
            if e=='u' then
                local hex=source:sub(pos,pos+3);assert(hex:match('^%x%x%x%x$'),"Unicode JSON invalide")
                local code=tonumber(hex,16);pos=pos+4
                if code>=0xD800 and code<=0xDBFF then
                    assert(source:sub(pos,pos+1)=='\\u',"Paire Unicode manquante")
                    local low=tonumber(source:sub(pos+2,pos+5),16)
                    assert(low and low>=0xDC00 and low<=0xDFFF,"Paire Unicode invalide")
                    code=0x10000+(code-0xD800)*1024+low-0xDC00;pos=pos+6
                else assert(code<0xDC00 or code>0xDFFF,"Unicode isole invalide") end
                parts[#parts+1]=utf8char(code)
            else assert(escapes[e],"Echappement JSON invalide");parts[#parts+1]=escapes[e] end
        end
        error("Chaine JSON incomplete")
    end
    parseValue=function()
        skip();depth=depth+1;assert(depth<40,"JSON trop imbrique")
        local c=source:sub(pos,pos);local result
        if c=='"' then result=parseString()
        elseif c=='{' or c=='[' then
            local object=c=='{';local close=object and '}' or ']';result={};pos=pos+1;skip()
            if source:sub(pos,pos)~=close then
                while true do
                    skip();local key
                    if object then key=parseString();skip();assert(source:sub(pos,pos)==':',"Separateur JSON attendu");pos=pos+1 end
                    local value=parseValue()
                    if object then result[key]=value else result[#result+1]=value end
                    skip();local endChar=source:sub(pos,pos);pos=pos+1
                    if endChar==close then break end
                    assert(endChar==',',"Virgule JSON attendue")
                end
            else pos=pos+1 end
        elseif source:sub(pos,pos+3)=='true' then result=true;pos=pos+4
        elseif source:sub(pos,pos+4)=='false' then result=false;pos=pos+5
        elseif source:sub(pos,pos+3)=='null' then result=nil;pos=pos+4
        else
            local token=source:sub(pos):match('^%-?%d+%.?%d*[eE]?[+%-]?%d*')
            result=token and tonumber(token);assert(result,"Valeur JSON invalide");pos=pos+#token
        end
        depth=depth-1;return result
    end
    local value=parseValue();skip();assert(pos>#source,"Fin JSON invalide");return value
end
local function nativeLong(hash,...)
    assert(type(API.InvokeNative)=="function" and Citizen and type(Citizen.ResultAsLong)=="function","Resultat natif 64 bits indisponible")
    local args={...};args[#args+1]=Citizen.ResultAsLong()
    return API.InvokeNative(hash,table.unpack(args))
end
local function createSiteTexture(dataUrl)
    local site=Menu.site
    if not site.txd then
        site.txd=type(CreateRuntimeTxd)=="function" and CreateRuntimeTxd("mirage_lapsus_banner") or nativeLong(0x1F3AC778,"mirage_lapsus_banner")
    end
    assert(site.txd and site.txd~=0,"Dictionnaire de texture indisponible")
    local texture
    if type(CreateRuntimeTextureFromImage)=="function" then texture=CreateRuntimeTextureFromImage(site.txd,"site_banner",dataUrl)
    else texture=nativeLong(0x786D8BC3,site.txd,"site_banner",dataUrl) end
    assert(texture and texture~=0,"Image du site non prise en charge")
    assert(type(DrawSprite)=="function" or type(API.InvokeNative)=="function","Rendu de texture indisponible")
    site.texture=texture;site.ready=true
end
local function imageBase64(bytes)
    local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local parts={}
    for i=1,#bytes,3 do
        if i%49152==1 then API.Wait(0);if not Menu.running then error("Menu arrete") end end
        local a,b,c=bytes:byte(i,i+2);local number=a*65536+(b or 0)*256+(c or 0)
        local x=math.floor(number/262144)%64+1;local y=math.floor(number/4096)%64+1
        local z=math.floor(number/64)%64+1;local t=number%64+1
        parts[#parts+1]=alphabet:sub(x,x)..alphabet:sub(y,y)..(b and alphabet:sub(z,z) or '=')..(c and alphabet:sub(t,t) or '=')
    end
    return table.concat(parts)
end
local function imageDataUrl(url)
    assert(type(url)=="string" and #url<=6*1024*1024,"Banniere absente ou trop volumineuse")
    if url:sub(1,5)=='data:' then
        local mime=url:match('^data:image/([%w]+);base64,')
        assert(mime=='png' or mime=='jpeg' or mime=='jpg' or mime=='webp',"Format de banniere non pris en charge")
        return url
    end
    assert(url:match('^https://'),"Adresse de banniere HTTPS attendue")
    local response=API.HttpGet(url)
    assert(type(response)=='table' and response.success and type(response.data)=='string',"Image du site indisponible")
    local bytes=response.data;assert(#bytes>0 and #bytes<=4*1024*1024,"Image trop volumineuse")
    local mime=bytes:sub(1,8)=='\137PNG\13\10\26\10' and 'png' or bytes:sub(1,2)=='\255\216' and 'jpeg' or nil
    assert(mime,"Le site doit fournir une image PNG ou JPEG")
    return 'data:image/'..mime..';base64,'..imageBase64(bytes)
end
local function bannerDimensions(dataUrl)
    local encoded=dataUrl:match('^data:image/[%w]+;base64,(.+)$')
    if not encoded then return nil,nil end
    local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup={}
    for i=1,#alphabet do lookup[alphabet:sub(i,i)]=i-1 end
    local bytes={};local buffer,bits=0,0
    for i=1,math.min(#encoded,196608) do
        local n=lookup[encoded:sub(i,i)]
        if n then
            buffer=buffer*64+n;bits=bits+6
            if bits>=8 then
                bits=bits-8;bytes[#bytes+1]=string.char(math.floor(buffer/2^bits)%256);buffer=buffer%2^bits
            end
        end
    end
    local raw=table.concat(bytes)
    local function u16(pos) local a,b=raw:byte(pos,pos+1);return b and a*256+b or nil end
    local function u32(pos) local a,b,c,d=raw:byte(pos,pos+3);return d and ((a*256+b)*256+c)*256+d or nil end
    local w,h
    if raw:sub(1,8)=='\137PNG\13\10\26\10' then w,h=u32(17),u32(21)
    elseif raw:sub(1,2)=='\255\216' then
        local pos=3
        while pos+8<=#raw do
            if raw:byte(pos)~=255 then pos=pos+1
            else
                local marker=raw:byte(pos+1)
                if marker==255 then pos=pos+1
                elseif marker==0xD9 or marker==0xDA then break
                elseif marker==0x01 or marker>=0xD0 and marker<=0xD8 then pos=pos+2
                else
                    local length=u16(pos+2)
                    if not length or length<2 then break end
                    local sof=marker>=0xC0 and marker<=0xCF and marker~=0xC4 and marker~=0xC8 and marker~=0xCC
                    if sof and length>=7 then h,w=u16(pos+5),u16(pos+7);break end
                    pos=pos+2+length
                end
            end
        end
    end
    if not w or not h or w<1 or h<1 or w>32768 or h>32768 then return nil,nil end
    return w,h
end

function Menu.RefreshSiteBanner()
    local site=Menu.site
    if site.loading or not Menu.running then return end
    if type(API.HttpGet)~="function" then site.status="API HTTP indisponible";site.initialized=true;return end
    site.loading=true;site.phase="config";site.startedAt=clock();site.status="Chargement du site..."
    API.CreateThread(function()
        local ok,err=protected(function()
            local response=API.HttpGet(site.endpoint)
            assert(type(response)=='table' and response.success and type(response.data)=='string',"Site indisponible")
            assert(#response.data<=6*1024*1024,"Configuration trop volumineuse")
            local document=decodeSiteJSON(response.data)
            assert(type(document)=='table' and document.ok~=false,"Configuration du site invalide")
            local config=type(document.config)=='table' and document.config or document
            site.phase="image"
            local dataUrl=imageDataUrl(config.banner_url)
            if not Menu.running then return end
            site.phase="texture"
            local imageWidth,imageHeight=bannerDimensions(dataUrl)
            local r,g,b=tonumber(config.r),tonumber(config.g),tonumber(config.b)
            if r and g and b then
                site.remoteAccent={clamp(r,0,255),clamp(g,0,255),clamp(b,0,255)}
                if not site.preferLocalTheme then site.accent=site.remoteAccent end
            end
            createSiteTexture(dataUrl)
            site.imageWidth,site.imageHeight=imageWidth,imageHeight
            local border={simple=1,solid=1,glow=2,anim=3,off=4}
            if not site.keepConfigStyle and Menu.settings.banner==2 and border[config.border_style] then Menu.settings.border=border[config.border_style] end
            if type(config.title)=='string' then site.title=config.title:gsub('[%c]',' '):sub(1,120) end
            site.hideTitle=config.hide_title==true or config.baked==true
            API.Wait(0) -- Laisser une frame pour publier la texture avant la premiere ouverture.
            if not Menu.running then return end
            site.status="Banniere du site chargee";site.error=nil
        end)
        if not Menu.running then return end
        if not ok then site.error=tostring(err);site.status=site.ready and "Actualisation impossible - image conservee" or site.phase=="texture" and "Rendu image indisponible" or "Banniere du site indisponible" end
        site.loading=false;site.initialized=true
    end)
end
function Menu.DrawSiteBanner(x,y,w,h,opacity,u1,v1,u2,v2,rounding)
    if not Menu.site.ready then return false end
    local sw,sh=API.GetScreenSize();if sw<=0 or sh<=0 or w<=0 or h<=0 then return false end
    u1,v1,u2,v2=(u1 or 0.0)+0.0,(v1 or 0.0)+0.0,(u2 or 1.0)+0.0,(v2 or 1.0)+0.0
    local alpha=math.floor(opacity*255+0.5)
    local function slice(sx,sy,swidth,sheight,tu1,tv1,tu2,tv2)
        if swidth<=0 or sheight<=0 then return end
        local nx,ny=(sx+swidth/2)/sw,(sy+sheight/2)/sh
        local nw,nh=swidth/sw,sheight/sh
        -- InvokeNative distinguishes Lua integers from float bit patterns.
        -- In particular UV endpoints must be 1.0, never integer 1.
        tu1,tv1,tu2,tv2=tu1+0.0,tv1+0.0,tu2+0.0,tv2+0.0
        local cropped=tu1>0.000001 or tv1>0.000001 or tu2<0.999999 or tv2<0.999999
        if cropped then
            local uvDraw=type(DrawSpriteUv)=="function" and DrawSpriteUv or type(_DrawSpriteUv)=="function" and _DrawSpriteUv
            if uvDraw then uvDraw("mirage_lapsus_banner","site_banner",nx,ny,nw,nh,tu1,tv1,tu2,tv2,0.0,255,255,255,alpha)
            else API.InvokeNative(0x95812F9B26074726,"mirage_lapsus_banner","site_banner",nx,ny,nw,nh,tu1,tv1,tu2,tv2,0.0,255,255,255,alpha) end
        elseif type(DrawSprite)=="function" then
            DrawSprite("mirage_lapsus_banner","site_banner",nx,ny,nw,nh,0.0,255,255,255,alpha)
        else
            API.InvokeNative(0xE7FFAE5EBF23D890,"mirage_lapsus_banner","site_banner",nx,ny,nw,nh,0.0,255,255,255,alpha,false)
        end
    end
    local ok=protected(function()
        local radius=math.min(rounding or 0,w/2,h/2)
        if radius>0 then
            -- Clip only the top corners, using texture UVs rather than painting over the image.
            local bands=math.max(1,math.ceil(radius))
            local bandH=radius/bands
            for i=0,bands-1 do
                local top=i*bandH
                local middle=top+bandH/2
                local inset=radius-math.sqrt(math.max(0,radius*radius-(radius-middle)^2))
                slice(x+inset,y+top,w-2*inset,bandH,
                    u1+(u2-u1)*inset/w,v1+(v2-v1)*top/h,
                    u2-(u2-u1)*inset/w,v1+(v2-v1)*(top+bandH)/h)
            end
            slice(x,y+radius,w,h-radius,u1,v1+(v2-v1)*radius/h,u2,v2)
        else slice(x,y,w,h,u1,v1,u2,v2) end
    end)
    if not ok then Menu.site.ready=false;Menu.site.status="Rendu de la banniere indisponible" end
    return ok
end


function Menu.ProcessModalInput()
    local modal=Menu.modal;if not modal then return end
    if not modal.armed then
        if not API.IsKeyDown(0x0D) and not API.IsKeyDown(0x1B) and not API.IsKeyPressed(0x0D) and not API.IsKeyPressed(0x1B) then modal.armed=true end
        return
    end
    if API.IsKeyPressed(0x1B) then finishModal(nil);return end
    if API.IsKeyPressed(0x0D) then
        if modal.kind=="confirm" then finishModal(true)
        else
            local ok,name=protected(cleanName,modal.buffer)
            if ok then finishModal(name) else modal.error="Nom attendu : 1 a 32 caracteres" end
        end
        return
    end
    if modal.kind~="text" then return end
    if API.IsKeyPressed(0x08) then modal.buffer=modal.buffer:match('^(.*)[%z\1-\127\194-\244][\128-\191]*$') or "" end
    local ctrl=API.IsKeyDown(0x11)
    if ctrl and API.IsKeyPressed(0x56) and type(API.GetClipboard)=="function" then
        local ok,value=protected(API.GetClipboard)
        if ok and type(value)=="string" then
            local chars={};for ch in value:gsub('[%c]',' '):gmatch('[%z\1-\127\194-\244][\128-\191]*') do if #chars>=modal.maxLen then break end;chars[#chars+1]=ch end
            modal.buffer=table.concat(chars)
        end
        return
    end
    if ctrl then return end
    local shift=API.IsKeyDown(0x10)
    for vk=0x41,0x5A do if API.IsKeyPressed(vk) and countChars(modal.buffer)<modal.maxLen then
        local ch=string.char(vk);modal.buffer=modal.buffer..(shift and ch or ch:lower())
    end end
    for vk=0x30,0x39 do if API.IsKeyPressed(vk) and countChars(modal.buffer)<modal.maxLen then modal.buffer=modal.buffer..string.char(vk) end end
    for vk=0x60,0x69 do if API.IsKeyPressed(vk) and countChars(modal.buffer)<modal.maxLen then modal.buffer=modal.buffer..tostring(vk-0x60) end end
    if countChars(modal.buffer)<modal.maxLen then
        if API.IsKeyPressed(0x20) then modal.buffer=modal.buffer.." " end
        if API.IsKeyPressed(0xBD) or API.IsKeyPressed(0x6D) then modal.buffer=modal.buffer..(shift and "_" or "-") end
    end
end

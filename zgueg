                            ApplyForceToEntity(targetPed, 1, pFwd.x * 20.0 + dir.x * 20.0, pFwd.y * 20.0 + dir.y * 20.0, -10.0, 0.0, 0.0, 0.0, 0, false, true, true, false, true)

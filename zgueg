                    targetPed = GetFreecamTarget("ped")
                end
                if not targetPed or not DoesEntityExist(targetPed) then
                    ShowDynastyNotification("[ RAGDOLL ] Aucun joueur vise")
                else
                    CreateThread(function()
                        local tCoords = GetEntityCoords(targetPed)
                        local serverId = targetPlayerId and GetPlayerServerId(targetPlayerId)
                        local guid = nil
                        if type(GetEntityGuid) == "function" then
                            pcall(function() guid = GetEntityGuid(targetPed) end)
                        end

                        -- 1. Envoi API Lapsus (tous formats)
                        local lapsus = rawget(_G, "Lapsus")
                        if (type(Lapsus) == "table" or type(lapsus) == "table") and type(Lapsus_RequestRagdoll_compat) == "function" then
                            if guid then pcall(Lapsus_RequestRagdoll_compat, guid) end
                            if serverId then pcall(Lapsus_RequestRagdoll_compat, serverId) end
                            if targetPlayerId then pcall(Lapsus_RequestRagdoll_compat, targetPlayerId) end
                            pcall(Lapsus_RequestRagdoll_compat, targetPed)
                        end

                        -- 2. Tir Taser 0 dégât (force l'état ragdoll taser natif du moteur)
                        local taserHash = GetHashKey("WEAPON_STUNGUN")
                        RequestWeaponAsset(taserHash, 31, 0)
                        ShootSingleBulletBetweenCoords(
                            tCoords.x, tCoords.y, tCoords.z + 1.2,
                            tCoords.x, tCoords.y, tCoords.z + 0.2,
                            0, true, taserHash, myPed, true, false, -1.0
                        )

